# Copie este archivo como .env y ajuste los valores.
DATABASE_URL=postgresql://terraviva:terraviva@localhost:5432/terraviva
PORT=3000
# Orígenes permitidos (separados por coma): la app web
CORS_ORIGINS=http://localhost:5173
WEB_URL=http://localhost:5173
# Secreto para firmar los tokens: genere uno con  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambie-este-valor-por-uno-largo-y-aleatorio
JWT_ACCESS_MIN=15
# Verificación en dos pasos: clave para cifrar las claves TOTP y firmar los desafíos del ingreso (mínimo 32 caracteres;
# genérela igual que JWT_SECRET). Vacía, se deriva de JWT_SECRET. En producción conviene una propia y guardada aparte:
# si se pierde o cambia, todos deben configurar de nuevo la verificación en dos pasos.
CLAVE_2FA=
REFRESH_DIAS=30
# Correo (si SMTP_HOST está vacío, los correos se escriben en la consola)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TERRY-GO · Terra Viva <no-responder@terravivasas.com>"
# Archivos de la operación (firmas, fotos, PDF) y lo que prepara la cola (ZIP, Excel). Nunca son públicos: se descargan
# con un enlace firmado de 5 minutos. «local» = carpeta del servidor (desarrollo); «s3» = S3, Cloudflare R2 o MinIO
# (producción: el archivo no pasa por el API). Bucket privado; para R2 o MinIO ponga su dirección en S3_ENDPOINT.
ALMACENAMIENTO=local
ALMACENAMIENTO_DIR=almacenamiento
ARCHIVO_MAX_MB=10
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_RUTA_EN_URL=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Cloudflare R2 con sus propios nombres (equivalen a los S3_* que falten; la región queda «auto»). Si falta R2_ENDPOINT,
# se arma con la cuenta: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com. Las claves van solo en este .env del API:
# nunca en el repositorio ni en el .env de la web (lo que empieza por VITE_ queda a la vista de cualquiera).
R2_BUCKET_NAME=
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Cola de trabajos: esta copia del API prepara archivos (false en una copia que solo atiende pantallas), cuántos a la vez
# y cuántos días se guarda lo preparado
TRABAJOS_PROCESAR=true
TRABAJOS_SIMULTANEOS=2
TRABAJOS_DIAS=7
# Ley 1581: versión vigente de la política de tratamiento de datos y enlace al texto publicado.
# Al cambiar la versión, cada usuario debe aceptarla de nuevo en su siguiente ingreso.
# Vacías: en desarrollo se usa la versión «borrador»; en producción (NODE_ENV=production) el API no arranca sin ellas.
POLITICA_DATOS_VERSION=
POLITICA_DATOS_URL=
# Límite de peticiones por minuto en cada ruta: por usuario con sesión, por IP sin ella
LIMITE_PETICIONES_MIN=300
# Techo de ingresos por minuto desde una misma IP, sumando todos los correos (en la prueba de carga súbalo a 1000)
LIMITE_INGRESOS_IP_MIN=60
# Solo para crear el administrador al sembrar la base (npm run db:seed)
SEED_ADMIN_PASSWORD=
