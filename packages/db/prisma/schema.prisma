// =====================================================================
// Terra Viva S.A.S. E.S.P. — Plataforma de Gestión Integral de Residuos
// Esquema relacional (PostgreSQL 16 + PostGIS)
//
// Hilo de trazabilidad:
// Cliente → Sucursal → Declaración (+Tarifa) → Solicitud → Parada de ruta
//   → Manifiesto → Conciliación (báscula Los Pinos) → Acta / Certificado → Factura
// =====================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto]
}

// ---------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------
enum TipoDeclaracion {
  RESIDUO
  SERVICIO
}

enum EstadoDeclaracion {
  BORRADOR // guardado parcial del formulario; no exige campos obligatorios
  PENDIENTE // enviado, esperando revisión de Terra Viva
  AUTORIZADA // aprobado: solo así se puede activar y programar
  RECHAZADA
  ANULADA // se deshizo el cargue que la creó: inactiva, sin cambios y con su código interno libre
}

enum TipoCliente {
  DIRECTO // el cliente es el generador
  GESTOR // el cliente gestiona residuos de terceros: cada sede es un generador
}

/// Regla del certificado de disposición de cada cliente (Siigo, gerencia 19-11-2026).
enum ReglaCertificado {
  AL_VENCER // la regla amable: en el portal se retiene si hay una factura vencida (días de gracia en Ajustes)
  EXIGIR_FACTURA // no se emite ni se descarga sin factura
  EXIGIR_PAGO // no se emite ni se descarga sin pago
  LIBRE // sin restricciones financieras
}

enum EstadoPagoManifiesto {
  PENDIENTE
  PAGADO
  LIBRE // facturación lo marcó sin cobro (con su motivo)
}

enum EstadoFacturaSiigo {
  PENDIENTE
  ABONADA
  PAGADA
  ANULADA // sus notas crédito la anulan
}

/// Por qué se inactiva un cliente (gerencia, 19-11-2026). En OTRO, la nota describe la eventualidad.
enum MotivoInactivacion {
  PAGOS_PENDIENTES
  ENTREGAS_NO_AUTORIZADAS
  OTRO
}

enum ClasificacionSede {
  RESIDENCIAL
  INDUSTRIAL
  INSTITUCIONAL
  COMERCIAL
}

enum EstadoFisico {
  SOLIDO
  SEMISOLIDO
  LIQUIDO
  GASEOSO
}

/// Sedes a las que aplica la declaración. Siempre se materializa en declaracion_sucursales;
/// este campo solo recuerda cómo se eligió (y si las sedes nuevas deben sumarse solas).
enum AlcanceSedes {
  TODAS
  PRINCIPAL
  SELECCION
}

enum UsoMetrica {
  PRECIO
  DENSIDAD
}

enum TipoCodigoClasificacion {
  A // Anexo II Dec. 1076/2015 (Lista A, Convenio de Basilea)
  Y // Anexo I Dec. 1076/2015 (corrientes Y1–Y45)
}

enum TipoCargue {
  SUCURSALES
  DECLARACIONES
}

enum EstadoCargue {
  VALIDADO // vista previa sin guardar
  CONFIRMADO // lote guardado
  FALLIDO
  REVERTIDO // lote deshecho: sus declaraciones quedaron anuladas (nada se borra)
}

enum TipoNegociacion {
  COBRO // el cliente paga por la gestión
  COMPRA // Terra Viva compra el material (aprovechables)
  SIN_COSTO
  CONTRATO // se factura aparte (tarifa global o contrato): la línea puede ir en 0
}

enum FormaPago {
  CONTADO
  CREDITO_30
  CREDITO_60
  CREDITO_90
}

enum ClaseSolicitud {
  PRE
  FORMAL
}

enum Operacion {
  CARGA
  DESCARGA
}

enum EstadoSolicitud {
  PENDIENTE
  PROGRAMADA
  EN_CURSO
  RECOLECTADA
  CANCELADA
}

enum EstadoParada {
  PENDIENTE
  ATENDIDA
  NO_ATENDIDA
}

enum ResultadoChequeo {
  OK
  NO_OK
  NA
}

// ---------- Núcleo operativo (fase 3-A) ----------
/// Aprobación comercial de la solicitud (distinta del avance operativo, que es EstadoSolicitud).
enum AprobacionSolicitud {
  PENDIENTE
  APROBADA
  NO_APROBADA
}

/// Avance de cada línea de la solicitud: se programa línea por línea.
enum EstadoItemSolicitud {
  PENDIENTE // sin programar
  PROGRAMADO // en una ruta activa
  REALIZADO // quedó en un manifiesto realizado
  DESCARTADO
}

enum Jornada {
  AM
  PM
  DIA // todo el día
}

enum TipoSeguridadSocial {
  ARL
  EPS
}

enum TipoManifiesto {
  CARGUE // Terra Viva recoge en la sede del cliente (con ruta)
  DESCARGUE // el cliente o un tercero entrega en planta (sin ruta)
}

enum EstadoManifiesto {
  PENDIENTE
  REALIZADO // grabado con firma, horas y báscula: abre la conciliación
  ANULADO
}

enum TipoConciliacion {
  INTERNA
  EXTERNA
}

enum TipoEvidencia {
  FOTO
  PDF
}

enum EstadoConciliacion {
  BORRADOR
  APROBADA // habilita el acta
  ANULADA // se anuló su manifiesto: queda para el historial, no se borra
}

enum EstadoPago {
  PENDIENTE
  ABONADA
  PAGADA
  ANULADA
}

enum EstadoActa {
  BORRADOR
  EMITIDA
  ANULADA
}

enum OrigenActa {
  GENERADA // la emite TERRY-GO con cantidades conciliadas
  CARGADA // acta de un gestor aliado, subida como archivo
}

enum TipoActa {
  DISPOSICION
  CONCILIACION
  APROVECHAMIENTO
}

/// Portal de clientes: el administrador del cliente crea los usuarios de su empresa; «consulta» solo ve y descarga.
enum PerfilPortal {
  ADMIN
  CONSULTA
}

/// Tipo de RCD según los numerales del Anexo II de la Res. 1257 de 2021 (constancia del gestor al generador)
enum TipoRcd {
  EXCAVACION // 1.1 Productos de excavación y sobrantes de la adecuación del terreno
  CIMENTACION // 1.2 Productos de cimentaciones y pilotajes
  PETREOS // 1.3 Pétreos
  NO_PETREOS // 1.4 No pétreos
  CONTAMINADO_RESPEL // 2.1 Contaminados con residuos peligrosos
  NO_APROVECHABLE // 2.2 Los que por su estado no pueden ser aprovechados
  PELIGROSO // 2.3 Los que tengan características de peligrosidad
}

enum EstadoPermiso {
  VIGENTE
  POR_VENCER
  VENCIDO
  EN_TRAMITE
}

enum UnidadMedida {
  KG
  TON
  M3
  GAL
  L
  UND
  SERVICIO
}

// ---------------------------------------------------------------------
// MULTIEMPRESA Y SEGURIDAD
// ---------------------------------------------------------------------
model Empresa {
  id            String   @id @default(uuid()) @db.Uuid
  nit           String   @unique @db.VarChar(15)
  razonSocial   String   @map("razon_social") @db.VarChar(200)
  logoUrl       String?  @map("logo_url")
  /// Ciudad de firma, representante legal, certificaciones (ISO, Norsok) y nota de calibración de la báscula
  configuracion Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  usuarios         Usuario[]
  roles            Rol[]
  clientes         Cliente[]
  proveedores      Proveedor[]
  vehiculos        Vehiculo[]
  bodegas          Bodega[]
  zonas            Zona[]
  catalogo         CatalogoResiduo[]
  declaraciones    Declaracion[]
  solicitudes      Solicitud[]
  rutas            Ruta[]
  estadosRuta      EstadoRecorrido[]
  catalogoItems    CatalogoItem[]
  elementosCheck   ElementoChequeo[]
  permisos         PermisoAmbiental[]
  manifiestos      Manifiesto[]
  actas            Acta[]
  categorias       CategoriaDeclarado[]
  tiposResiduo     TipoResiduo[]
  unidades         UnidadNegocio[]
  lineas           LineaServicio[]
  metricas         Metrica[]
  disposiciones    Disposicion[]
  tiposEmbalaje    TipoEmbalaje[]
  materiales       MaterialEmbalaje[]
  cargues          CargueMasivo[]
  especificaciones EspecificacionAdicional[]
  transportes      TransporteTercero[]
  conciliaciones   Conciliacion[]
  consecutivos     Consecutivo[]
  textosLegales    TextoLegal[]

  trabajos                Trabajo[] // cola de trabajos (ZIP, Excel)
  certificadosComerciales CertificadoComercial[]
  facturasSiigo           FacturaSiigo[]
  manifiestosFinanzas     ManifiestoFinanzas[]
  sincronizacionesSiigo   SincronizacionSiigo[]
  eventosGps              EventoGps[]
  wialonEstado            WialonEstado?

  @@map("empresas")
}

model Rol {
  id        String       @id @default(uuid()) @db.Uuid
  empresaId String       @map("empresa_id") @db.Uuid
  nombre    String       @db.VarChar(60)
  empresa   Empresa      @relation(fields: [empresaId], references: [id])
  permisos  RolPermiso[]
  usuarios  Usuario[]

  @@unique([empresaId, nombre])
  @@map("roles")
}

model Permiso {
  id     String       @id @default(uuid()) @db.Uuid
  codigo String       @unique @db.VarChar(60) // ej. "rutas.editar"
  nombre String       @db.VarChar(120)
  roles  RolPermiso[]

  @@map("permisos")
}

model RolPermiso {
  rolId     String  @map("rol_id") @db.Uuid
  permisoId String  @map("permiso_id") @db.Uuid
  rol       Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso   Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@map("rol_permisos")
}

model Usuario {
  id                   String        @id @default(uuid()) @db.Uuid
  empresaId            String        @map("empresa_id") @db.Uuid
  rolId                String        @map("rol_id") @db.Uuid
  nombre               String        @db.VarChar(150)
  documento            String        @db.VarChar(20)
  email                String        @unique @db.VarChar(150)
  passwordHash         String        @map("password_hash")
  telefono             String?       @db.VarChar(20)
  esConductor          Boolean       @default(false) @map("es_conductor")
  esAuxiliar           Boolean       @default(false) @map("es_auxiliar")
  licenciaCat          String?       @map("licencia_cat") @db.VarChar(5)
  licenciaVence        DateTime?     @map("licencia_vence") @db.Date
  cursoMpVence         DateTime?     @map("curso_mp_vence") @db.Date // Res. 1223/2014
  arlId                String?       @map("arl_id") @db.Uuid // seguridad social: requisito de ingreso a planta
  epsId                String?       @map("eps_id") @db.Uuid
  activo               Boolean       @default(true)
  ultimoLogin          DateTime?     @map("ultimo_login") @db.Timestamptz
  // Ley 1581 de 2012: aceptación de la política de tratamiento de datos (versión, fecha e IP)
  datosPoliticaVersion String?       @map("datos_politica_version") @db.VarChar(20)
  datosAceptadosEn     DateTime?     @map("datos_aceptados_en") @db.Timestamptz
  datosAceptadosIp     String?       @map("datos_aceptados_ip") @db.VarChar(64)
  // Verificación en dos pasos (TOTP): secreto cifrado, el pendiente mientras se configura y el último paso usado
  totpSecreto          String?       @map("totp_secreto")
  totpPendiente        String?       @map("totp_pendiente")
  totpActivoDesde      DateTime?     @map("totp_activo_desde") @db.Timestamptz
  totpUltimoPaso       Int?          @map("totp_ultimo_paso")
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz
  // Portal de clientes: usuario de un cliente, con su perfil (ver migración 20261126000000_portal_clientes).
  // Sin sedes en usuario_sucursales, ve todas las del cliente.
  clienteId            String?       @map("cliente_id") @db.Uuid
  perfilPortal         PerfilPortal? @map("perfil_portal")

  empresa                 Empresa                  @relation(fields: [empresaId], references: [id])
  rol                     Rol                      @relation(fields: [rolId], references: [id])
  clientePortal           Cliente?                 @relation("UsuarioPortal", fields: [clienteId], references: [id], onDelete: Restrict)
  sedesPortal             UsuarioSucursal[]
  codigosRespaldo         CodigoRespaldo[]
  arl                     EntidadSeguridadSocial?  @relation("UsuarioArl", fields: [arlId], references: [id])
  eps                     EntidadSeguridadSocial?  @relation("UsuarioEps", fields: [epsId], references: [id])
  rutasConductor          Ruta[]                   @relation("RutaConductor")
  rutasAuxiliar           Ruta[]                   @relation("RutaAuxiliar")
  preopConductor          Preoperacional[]         @relation("PreopConductor")
  preopAuxiliar           Preoperacional[]         @relation("PreopAuxiliar")
  manifiestos             Manifiesto[]             @relation("MfConductor")
  manifiestosAuxiliar     Manifiesto[]             @relation("MfAuxiliar")
  manifiestosCreados      Manifiesto[]             @relation("MfCreadoPor")
  manifiestosRealizados   Manifiesto[]             @relation("MfRealizadoPor")
  manifiestosAnulados     Manifiesto[]             @relation("MfAnuladoPor")
  manifiestosRecibidos    Manifiesto[]             @relation("MfReceptor")
  textosLegales           TextoLegal[]             @relation("TextoLegalCreadoPor")
  evidenciasSubidas       ManifiestoEvidencia[]
  solicitudesAprobadas    Solicitud[]              @relation("SolAprobadaPor")
  conciliacionesAprobadas Conciliacion[]
  actasEmitidas           Acta[]                   @relation("ActaEmitidaPor")
  actasCargadas           Acta[]                   @relation("ActaCargadaPor")
  actasLiberadas          Acta[]                   @relation("ActaDescargaLiberada")
  clientesAsesorados      Cliente[]                @relation("ClienteAsesor")
  tarifasAsignadas        Tarifa[]
  solicitudesCreadas      Solicitud[]
  resetTokens             PasswordReset[]
  sesiones                Sesion[]
  intentosFallidos        Int                      @default(0) @map("intentos_fallidos")
  bloqueadoHasta          DateTime?                @map("bloqueado_hasta") @db.Timestamptz
  auditoria               Auditoria[]
  declaracionesAprobadas  Declaracion[]            @relation("DeclAprobadaPor")
  declaracionesAceptadas  Declaracion[]            @relation("DeclAceptadaPor")
  declaracionesRevision   Declaracion[]            @relation("DeclRevisionPedidaPor")
  eventosGpsRevisados     EventoGps[]              @relation("EventoGpsRevisor")
  carguesRevertidos       CargueMasivo[]           @relation("CargueRevertidoPor")
  cumplimientos           ObligacionCumplimiento[] @relation("CumplimientoUsuario")
  declaracionesCreadas    Declaracion[]            @relation("DeclCreadaPor")
  trabajos                Trabajo[] // lo que pidió preparar (sus descargas)
  certificadosComerciales CertificadoComercial[]   @relation("CertificadoComercialSolicitante")
  facturasEnlazadas       FacturaManifiesto[]
  manifiestosLiberados    ManifiestoFinanzas[]
  sincronizacionesSiigo   SincronizacionSiigo[]

  @@index([empresaId])
  @@map("usuarios")
}

/**
 * Sesión activa: guarda el hash del token de renovación (nunca el token). Permite cerrar sesiones remotamente.
 */
model Sesion {
  id         String    @id @default(uuid()) @db.Uuid
  usuarioId  String    @map("usuario_id") @db.Uuid
  tokenHash  String    @map("token_hash")
  userAgent  String?   @map("user_agent") @db.VarChar(300)
  ip         String?   @db.VarChar(64)
  creadaEn   DateTime  @default(now()) @map("creada_en") @db.Timestamptz
  expiraEn   DateTime  @map("expira_en") @db.Timestamptz
  revocadaEn DateTime? @map("revocada_en") @db.Timestamptz
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("sesiones")
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  usuarioId String    @map("usuario_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiraEn  DateTime  @map("expira_en") @db.Timestamptz
  usadoEn   DateTime? @map("usado_en") @db.Timestamptz
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

// ---------------------------------------------------------------------
// ENTIDADES BASE
// ---------------------------------------------------------------------
model Cliente {
  id                 String              @id @default(uuid()) @db.Uuid
  empresaId          String              @map("empresa_id") @db.Uuid
  nit                String              @db.VarChar(15)
  dv                 String?             @db.Char(1)
  razonSocial        String              @map("razon_social") @db.VarChar(200)
  tipo               TipoCliente         @default(DIRECTO)
  sector             String?             @db.VarChar(60) // de la lista SECTORES (@terraviva/shared); un valor antiguo se respeta hasta editarlo
  tipoNegociacion    TipoNegociacion     @default(COBRO) @map("tipo_negociacion")
  formaPago          FormaPago           @default(CONTADO) @map("forma_pago")
  emailFacturacion   String?             @map("email_facturacion") @db.VarChar(150)
  representanteLegal String?             @map("representante_legal") @db.VarChar(150) // constancia de RCD (Anexo II)
  asesorId           String?             @map("asesor_id") @db.Uuid // asesor comercial (aparece en conciliaciones)
  activo             Boolean             @default(true)
  // Inactivo siempre con su motivo y fecha (CHECK en la base); al reactivarlo se limpian y la auditoría conserva la historia
  motivoInactivacion MotivoInactivacion? @map("motivo_inactivacion")
  notaInactivacion   String?             @map("nota_inactivacion") @db.VarChar(500) // interna: el portal no la muestra
  inactivadoEn       DateTime?           @map("inactivado_en") @db.Timestamptz
  reglaCertificado   ReglaCertificado    @default(AL_VENCER) @map("regla_certificado") // solo la ven y cambian Comercial, Facturación y Gerencia
  camposExtra        Json                @default("{}") @map("campos_extra")

  empresa                 Empresa                @relation(fields: [empresaId], references: [id])
  asesor                  Usuario?               @relation("ClienteAsesor", fields: [asesorId], references: [id])
  sucursales              Sucursal[]
  declaraciones           Declaracion[]
  solicitudes             Solicitud[]
  manifiestos             Manifiesto[]
  actas                   Acta[]
  cargues                 CargueMasivo[]
  usuariosPortal          Usuario[]              @relation("UsuarioPortal")
  certificadosComerciales CertificadoComercial[]
  facturasSiigo           FacturaSiigo[]

  @@unique([empresaId, nit])
  @@map("clientes")
}

model Sucursal {
  id              String             @id @default(uuid()) @db.Uuid
  clienteId       String             @map("cliente_id") @db.Uuid
  zonaId          String?            @map("zona_id") @db.Uuid
  codigo          String?            @db.VarChar(20) // "C001": así se referencia en las plantillas
  nombre          String             @db.VarChar(150)
  esPrincipal     Boolean            @default(false) @map("es_principal") // una por cliente (índice parcial en SQL)
  clasificacion   ClasificacionSede?
  // Solo clientes GESTOR: la sede representa a un generador tercero
  generadorNit    String?            @map("generador_nit") @db.VarChar(15)
  generadorNombre String?            @map("generador_nombre") @db.VarChar(200)
  direccion       String?            @db.VarChar(300)
  municipioDane   String?            @map("municipio_dane") @db.Char(5) // DIVIPOLA
  latitud         Decimal?           @db.Decimal(9, 6) // en producción: GEOGRAPHY(POINT,4326) vía PostGIS
  longitud        Decimal?           @db.Decimal(9, 6)
  registroRespel  String?            @map("registro_respel") @db.VarChar(50) // Registro generador IDEAM
  registroRcd     String?            @map("registro_rcd") @db.VarChar(50) // N.º único del generador de RCD por proyecto (Anexo II)
  contacto        String?            @db.VarChar(150)
  telefono        String?            @db.VarChar(20)
  celular         String?            @db.VarChar(20)
  emails          String?            @db.VarChar(200) // separados por coma
  atencionLvDesde DateTime?          @map("atencion_lv_desde") @db.Time(0)
  atencionLvHasta DateTime?          @map("atencion_lv_hasta") @db.Time(0)
  atencionFdDesde DateTime?          @map("atencion_fd_desde") @db.Time(0) // fin de semana / festivo
  atencionFdHasta DateTime?          @map("atencion_fd_hasta") @db.Time(0)
  observaciones   String?
  activa          Boolean            @default(true)

  cliente         Cliente               @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  zona            Zona?                 @relation(fields: [zonaId], references: [id])
  municipio       Municipio?            @relation(fields: [municipioDane], references: [codigoDane])
  declaraciones   DeclaracionSucursal[]
  solicitudItems  SolicitudItem[]
  paradas         RutaParada[]
  manifiestoItems ManifiestoItem[] // como generador de la línea
  usuariosPortal  UsuarioSucursal[] // usuarios del portal restringidos a esta sede

  @@unique([clienteId, codigo])
  @@map("sucursales")
}

model Proveedor {
  id                    String    @id @default(uuid()) @db.Uuid
  empresaId             String    @map("empresa_id") @db.Uuid
  nit                   String    @db.VarChar(15)
  razonSocial           String    @map("razon_social") @db.VarChar(200)
  esDestino             Boolean   @default(true) @map("es_destino") // planta / gestor de destino
  esPropio              Boolean   @default(false) @map("es_propio") // Parque de Saneamiento Ambiental Los Pinos
  esTransportador       Boolean   @default(false) @map("es_transportador") // dueño de vehículos que Terra Viva contrata
  licencia              String?   @db.VarChar(300) // acto administrativo del gestor (número, fecha y modificaciones)
  licenciaAutoridad     String?   @map("licencia_autoridad") @db.VarChar(80)
  licenciaIndefinida    Boolean   @default(false) @map("licencia_indefinida") // el acto no fija término (vida útil del proyecto)
  licenciaUrl           String?   @map("licencia_url") // PDF de la licencia
  alcance               String? // qué residuos acepta y cuáles excluye
  excluyeTiposResiduo   String[]  @default([]) @map("excluye_tipos_residuo") @db.VarChar(20) // códigos de tipos_residuo (p. ej. HOSP)
  soporteComercial      String?   @map("soporte_comercial") @db.VarChar(200)
  soporteComercialFecha DateTime? @map("soporte_comercial_fecha") @db.Date
  licenciaVence         DateTime? @map("licencia_vence") @db.Date // vencida, o sin fecha y no indefinida ⇒ no cubre la disposición
  municipio             String?   @db.VarChar(80)
  activo                Boolean   @default(true) // se trabaja hoy con él: inactivo no cubre ni se ofrece como destino (la planta propia siempre activa)

  empresa                  Empresa             @relation(fields: [empresaId], references: [id])
  disposicionesGestionadas DisposicionGestor[] // disposiciones que hace como gestor aliado
  manifiestos              Manifiesto[]
  actas                    Acta[]
  vehiculos                Vehiculo[] // vehículos de terceros (flete)
  solicitudes              Solicitud[] // destino de descarga

  @@map("proveedores")
}

model Zona {
  id        String @id @default(uuid()) @db.Uuid
  empresaId String @map("empresa_id") @db.Uuid
  nombre    String @db.VarChar(80)
  color     String @default("#15803D") @db.VarChar(7)
  // poligono GEOGRAPHY(POLYGON,4326) — agregado vía migración SQL (PostGIS)

  empresa    Empresa    @relation(fields: [empresaId], references: [id])
  sucursales Sucursal[]
  rutas      Ruta[]

  @@map("zonas")
}

/// Sedes que puede ver un usuario del portal (sin filas: todas las de su cliente).
/// Códigos de respaldo de la verificación en dos pasos: de un solo uso, guardados como huella SHA-256
model CodigoRespaldo {
  id         String    @id @default(uuid()) @db.Uuid
  usuarioId  String    @map("usuario_id") @db.Uuid
  codigoHash String    @map("codigo_hash") @db.Char(64)
  usadoEn    DateTime? @map("usado_en") @db.Timestamptz
  creadoEn   DateTime  @default(now()) @map("creado_en") @db.Timestamptz

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId], map: "ix_codigos_respaldo_usuario")
  @@map("codigos_respaldo")
}

model UsuarioSucursal {
  usuarioId  String   @map("usuario_id") @db.Uuid
  sucursalId String   @map("sucursal_id") @db.Uuid
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Cascade)

  @@id([usuarioId, sucursalId])
  @@map("usuario_sucursales")
}

model Bodega {
  id        String     @id @default(uuid()) @db.Uuid
  empresaId String     @map("empresa_id") @db.Uuid
  nombre    String     @db.VarChar(100)
  empresa   Empresa    @relation(fields: [empresaId], references: [id])
  vehiculos Vehiculo[]

  @@map("bodegas")
}

model Vehiculo {
  id             String       @id @default(uuid()) @db.Uuid
  empresaId      String       @map("empresa_id") @db.Uuid
  bodegaId       String?      @map("bodega_id") @db.Uuid
  placa          String       @unique @db.VarChar(7)
  marca          String?      @db.VarChar(40)
  color          String       @default("#1E7838") @db.VarChar(7) // color en el calendario de programación
  tipo           String       @db.VarChar(40) // furgón RESPEL, vactor, volqueta, estacas
  capacidad      Decimal      @db.Decimal(10, 2)
  unidadCap      UnidadMedida @default(KG) @map("unidad_cap")
  volumenM3      Decimal?     @map("volumen_m3") @db.Decimal(8, 2)
  proveedorId    String?      @map("proveedor_id") @db.Uuid // NULL = propio; si no, el transportador que cobra flete
  soatVence      DateTime?    @map("soat_vence") @db.Date
  rtmVence       DateTime?    @map("rtm_vence") @db.Date
  polizaRcVence  DateTime?    @map("poliza_rc_vence") @db.Date
  activo         Boolean      @default(true)
  // Unidad de Wialon (GPS de la flota): se enlaza sola si el nombre de la unidad trae la placa, o a mano en Flota
  wialonUnidadId Int?         @map("wialon_unidad_id")
  wialonNombre   String?      @map("wialon_nombre") @db.VarChar(100)

  empresa          Empresa          @relation(fields: [empresaId], references: [id])
  bodega           Bodega?          @relation(fields: [bodegaId], references: [id])
  proveedor        Proveedor?       @relation(fields: [proveedorId], references: [id])
  rastreo          RutaRastreo[]
  rutas            Ruta[]
  preoperacionales Preoperacional[]
  manifiestos      Manifiesto[]
  gps              VehiculoGps?
  rutasGps         RutaGps[]
  eventosGps       EventoGps[]

  @@map("vehiculos")
}

// Listas simples sin reglas propias (causales de rechazo/cancelación…). Los catálogos del
// módulo de Declaraciones tienen tabla propia (ver más abajo) porque llevan FK y reglas.
model CatalogoItem {
  id        String  @id @default(uuid()) @db.Uuid
  empresaId String  @map("empresa_id") @db.Uuid
  tipo      String  @db.VarChar(40) // CAUSAL | …
  codigo    String  @db.VarChar(20)
  nombre    String  @db.VarChar(150)
  color     String? @db.VarChar(7)
  activo    Boolean @default(true)
  meta      Json    @default("{}")

  empresa             Empresa         @relation(fields: [empresaId], references: [id])
  declaracionesCausal Declaracion[]   @relation("CausalDeclaracion")
  solicitudesCausal   Solicitud[]     @relation("CausalCancelacion")
  itemsDescartados    SolicitudItem[]
  manifiestosAnulados Manifiesto[]    @relation("CausalAnulacionMf")

  @@unique([empresaId, tipo, codigo])
  @@map("catalogo_items")
}

// ---------------------------------------------------------------------
// PERMISOS AMBIENTALES (prioridad #1: cumplimiento)
// ---------------------------------------------------------------------
model PermisoAmbiental {
  id           String        @id @default(uuid()) @db.Uuid
  empresaId    String        @map("empresa_id") @db.Uuid
  acto         String        @db.VarChar(60) // "Resolución 0235-2024"
  autoridad    String        @db.VarChar(80) // "CAS"
  alcance      String
  expedicion   DateTime?     @db.Date
  vence        DateTime?     @db.Date
  estado       EstadoPermiso @default(VIGENTE)
  documentoUrl String?       @map("documento_url")

  empresa       Empresa              @relation(fields: [empresaId], references: [id])
  obligaciones  ObligacionPermiso[]
  disposiciones PermisoDisposicion[] // qué disposiciones/manejos ampara este acto

  @@map("permisos_ambientales")
}

model ObligacionPermiso {
  id            String                   @id @default(uuid()) @db.Uuid
  permisoId     String                   @map("permiso_id") @db.Uuid
  descripcion   String // ICA, monitoreo de suelos, caracterización de vertimiento…
  codigo        String?                  @db.VarChar(10) // ID del Cronograma Maestro de Cumplimiento (OB-xx)
  periodicidad  String                   @db.VarChar(120)
  meses         Int?                     @db.SmallInt // al cumplirla, la próxima fecha avanza estos meses (vacío = no se repite)
  articulo      String?                  @db.VarChar(120)
  proximaFecha  DateTime?                @map("proxima_fecha") @db.Date // vacía: permanente o por evento
  responsable   String?                  @db.VarChar(120)
  cumplida      Boolean                  @default(false)
  permiso       PermisoAmbiental         @relation(fields: [permisoId], references: [id], onDelete: Cascade)
  cumplimientos ObligacionCumplimiento[]

  @@map("obligaciones_permiso")
}

/// Cada vez que se cumple una obligación: fecha, radicado ante la autoridad y soporte. No se modifica ni se borra
/// (trg_cumplimiento_inmutable). Exige algún soporte (chk_cumplimiento_soporte).
model ObligacionCumplimiento {
  id              String    @id @default(uuid()) @db.Uuid
  obligacionId    String    @map("obligacion_id") @db.Uuid
  fechaProgramada DateTime? @map("fecha_programada") @db.Date // vacía en las obligaciones por evento
  cumplidaEn      DateTime  @map("cumplida_en") @db.Date
  radicado        String?   @db.VarChar(80)
  soporteUrl      String?   @map("soporte_url")
  nota            String?   @db.VarChar(500)
  usuarioId       String    @map("usuario_id") @db.Uuid
  creadoEn        DateTime  @default(now()) @map("creado_en") @db.Timestamptz

  obligacion ObligacionPermiso @relation(fields: [obligacionId], references: [id], onDelete: Restrict)
  usuario    Usuario           @relation("CumplimientoUsuario", fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([obligacionId, cumplidaEn(sort: Desc)], map: "ix_cumplimiento_obligacion")
  @@map("obligacion_cumplimientos")
}

// ---------------------------------------------------------------------
// CATÁLOGO DE RESIDUOS / SERVICIOS Y DECLARACIONES
// ---------------------------------------------------------------------
/// «Mis residuos frecuentes»: plantilla con la que se precarga el formulario de declaración.
/// No es la declaración: la declaración copia los valores y queda independiente.
model CatalogoResiduo {
  id              String          @id @default(uuid()) @db.Uuid
  empresaId       String          @map("empresa_id") @db.Uuid
  tipo            TipoDeclaracion
  codigo          String          @db.VarChar(20)
  nombre          String          @db.VarChar(200)
  lineaServicioId String?         @map("linea_servicio_id") @db.Uuid
  valores         Json            @default("{}") // instantánea de las secciones 2 a 6 del formulario
  activo          Boolean         @default(true)

  empresa       Empresa        @relation(fields: [empresaId], references: [id])
  lineaServicio LineaServicio? @relation(fields: [lineaServicioId], references: [id])
  declaraciones Declaracion[]

  @@unique([empresaId, codigo])
  @@map("catalogo_residuos")
}

/// Declaración: parametrización de UN residuo o servicio para UN cliente, aplicable a una o
/// varias de sus sedes. Las secciones del formulario se indican con [1]…[8].
/// Reglas que no caben en Prisma (CHECK y triggers): ver migración «declaraciones_reglas».
model Declaracion {
  id        String          @id @default(uuid()) @db.Uuid
  empresaId String          @map("empresa_id") @db.Uuid
  numero    Int             @default(autoincrement()) // consecutivo visible al cliente
  tipo      TipoDeclaracion

  // [1] Información del generador
  clienteId    String       @map("cliente_id") @db.Uuid
  alcanceSedes AlcanceSedes @default(SELECCION) @map("alcance_sedes")

  // [2] Datos específicos
  nombre              String   @db.VarChar(200)
  codigoInterno       String?  @map("codigo_interno") @db.VarChar(40) // código del cliente
  catalogoId          String?  @map("catalogo_id") @db.Uuid // plantilla usada para precargar
  categoriaId         String   @map("categoria_id") @db.Uuid
  tipoResiduoId       String?  @map("tipo_residuo_id") @db.Uuid // obligatorio si tipo = RESIDUO
  lineaServicioId     String   @map("linea_servicio_id") @db.Uuid // la unidad de negocio se deriva de aquí
  esPeligroso         Boolean  @default(false) @map("es_peligroso")
  frecuenciaDias      Int?     @map("frecuencia_dias")
  cantidadFrecuencia  Decimal? @map("cantidad_frecuencia") @db.Decimal(12, 2)
  solicitudAutomatica Boolean  @default(false) @map("solicitud_automatica") // crea la solicitud cada «frecuenciaDias»
  codigoAId           String?  @map("codigo_a_id") @db.Uuid
  codigoYId           String?  @map("codigo_y_id") @db.Uuid
  codigoUn            String?  @map("codigo_un") @db.VarChar(6) // "UN3082"
  descripcionProceso  String?  @map("descripcion_proceso") // proceso que generó el residuo
  composicion         String? // composición fisicoquímica
  descripcionServicio String?  @map("descripcion_servicio") @db.VarChar(1000)

  // [3] Embalaje
  tipoEmbalajeId     String? @map("tipo_embalaje_id") @db.Uuid
  otroTipoEmbalaje   String? @map("otro_tipo_embalaje") @db.VarChar(80) // si el tipo elegido es «Otro»
  presentacion       String? @db.VarChar(60) // tamaño: "55 gal", "1 m³"
  materialEmbalajeId String? @map("material_embalaje_id") @db.Uuid
  otroMaterial       String? @map("otro_material") @db.VarChar(80)
  tipoSellado        String? @map("tipo_sellado") @db.VarChar(80) // tapa aro, nudo, cinta…

  // [4] Características fisicoquímicas
  estadoFisico              EstadoFisico? @map("estado_fisico")
  tipoRcd                   TipoRcd?      @map("tipo_rcd") // solo RCD: numeral del Anexo II de la Res. 1257 de 2021
  inflamable                Boolean?
  controladaEstupefacientes Boolean?      @map("controlada_estupefacientes") // Ley 30/1986 · FNE
  color                     String?       @db.VarChar(60)
  olor                      String?       @db.VarChar(120)
  densidad                  Decimal?      @db.Decimal(12, 4)
  metricaDensidadId         String?       @map("metrica_densidad_id") @db.Uuid

  // [5] Disposición y manejo → declaracion_disposiciones (N:M)
  // [6] Información adicional
  datosExtras       String? @map("datos_extras")
  fichaSeguridadUrl String? @map("ficha_seguridad_url") // FDS (PDF/imagen) en S3
  serial            String? @db.VarChar(60) // serial genérico / del proveedor

  // [7] Precio → tabla tarifas (vigencias; el precio anterior nunca se borra)
  mostrarPrecioApp Boolean @default(false) @map("mostrar_precio_app")

  // [8] Estado de la declaración
  estado                  EstadoDeclaracion @default(PENDIENTE)
  activa                  Boolean           @default(false)
  observaciones           String?
  causalId                String?           @map("causal_id") @db.Uuid // motivo de rechazo / inactivación
  aprobadaPorId           String?           @map("aprobada_por") @db.Uuid
  aprobadaEn              DateTime?         @map("aprobada_en") @db.Timestamptz
  vigenteHasta            DateTime?         @map("vigente_hasta") @db.Date // recaracterización
  // Declaración de responsabilidad del generador (veracidad de la información)
  responsabilidadAceptada Boolean           @default(false) @map("responsabilidad_aceptada")
  aceptadaPorId           String?           @map("aceptada_por") @db.Uuid
  aceptadaEn              DateTime?         @map("aceptada_en") @db.Timestamptz

  // Trazabilidad del registro
  /// Convertida de la fase 1: puede inactivarse o rechazarse sin completar las secciones nuevas;
  /// para activarla o autorizarla debe completarse (reglas chk_decl_* de la migración).
  // Hidrocarburos y caracterización (respuestas de la gerencia, 19-11-2026): BIO solo con CRETIB negativa; RCD no los admite
  contieneHidrocarburos Boolean @default(false) @map("contiene_hidrocarburos")
  caracterizacionUrl    String? @map("caracterizacion_url")
  // Cambio crítico: quien lo hizo no puede autorizarla (cuatro ojos)
  revisionPedidaPorId   String? @map("revision_pedida_por") @db.Uuid

  origenFase1 Boolean  @default(false) @map("origen_fase1")
  cargueId    String?  @map("cargue_id") @db.Uuid // lote de cargue masivo que la creó
  creadoPorId String?  @map("creado_por") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  empresa           Empresa              @relation(fields: [empresaId], references: [id])
  cliente           Cliente              @relation(fields: [clienteId], references: [id])
  catalogo          CatalogoResiduo?     @relation(fields: [catalogoId], references: [id])
  categoria         CategoriaDeclarado   @relation(fields: [categoriaId], references: [id])
  tipoResiduo       TipoResiduo?         @relation(fields: [tipoResiduoId], references: [id])
  lineaServicio     LineaServicio        @relation(fields: [lineaServicioId], references: [id])
  codigoA           CodigoClasificacion? @relation("CodigoA", fields: [codigoAId], references: [id])
  codigoY           CodigoClasificacion? @relation("CodigoY", fields: [codigoYId], references: [id])
  tipoEmbalaje      TipoEmbalaje?        @relation(fields: [tipoEmbalajeId], references: [id])
  material          MaterialEmbalaje?    @relation(fields: [materialEmbalajeId], references: [id])
  metricaDensidad   Metrica?             @relation(fields: [metricaDensidadId], references: [id])
  causal            CatalogoItem?        @relation("CausalDeclaracion", fields: [causalId], references: [id])
  aprobadaPor       Usuario?             @relation("DeclAprobadaPor", fields: [aprobadaPorId], references: [id])
  aceptadaPor       Usuario?             @relation("DeclAceptadaPor", fields: [aceptadaPorId], references: [id])
  revisionPedidaPor Usuario?             @relation("DeclRevisionPedidaPor", fields: [revisionPedidaPorId], references: [id])
  creadoPor         Usuario?             @relation("DeclCreadaPor", fields: [creadoPorId], references: [id])
  cargue            CargueMasivo?        @relation(fields: [cargueId], references: [id])

  sucursales      DeclaracionSucursal[]
  disposiciones   DeclaracionDisposicion[]
  riesgos         DeclaracionRiesgo[]
  etiquetados     DeclaracionEtiquetado[]
  tarifas         Tarifa[]
  items           SolicitudItem[]
  manifiestoItems ManifiestoItem[]

  @@unique([empresaId, numero])
  // Código interno único por cliente entre las no anuladas: índice parcial ux_decl_codigo_interno (migración
  // 20261124000100_cargues_csv_reversion; Prisma no describe índices parciales).
  @@index([empresaId, tipo, estado, activa])
  @@index([clienteId])
  @@index([lineaServicioId])
  @@map("declaraciones")
}

// Los precios nunca se sobrescriben: cada cambio es una nueva vigencia.
model Tarifa {
  id               String          @id @default(uuid()) @db.Uuid
  declaracionId    String          @map("declaracion_id") @db.Uuid
  precioUnitario   Decimal         @map("precio_unitario") @db.Decimal(14, 2)
  metricaId        String?         @map("metrica_id") @db.Uuid // NULL = precio GLOBAL (por servicio)
  tipoNegociacion  TipoNegociacion @map("tipo_negociacion")
  formaPago        FormaPago       @map("forma_pago")
  vigenteDesde     DateTime        @map("vigente_desde") @db.Date
  vigenteHasta     DateTime?       @map("vigente_hasta") @db.Date
  loteAsignacionId String?         @map("lote_asignacion_id") @db.Uuid // asignación masiva
  asignadoPorId    String?         @map("asignado_por") @db.Uuid

  declaracion Declaracion @relation(fields: [declaracionId], references: [id], onDelete: Cascade)
  metrica     Metrica?    @relation(fields: [metricaId], references: [id])
  asignadoPor Usuario?    @relation(fields: [asignadoPorId], references: [id])

  @@index([declaracionId, vigenteDesde])
  @@map("tarifas")
}

// ---------------------------------------------------------------------
// LOGÍSTICA
// ---------------------------------------------------------------------
/// Solicitud de recolección (CARGA) o de entrega en planta (DESCARGA). La sede va en cada línea.
/// clase PRE = solicitud recurrente creada sola (desde un manifiesto) que espera activarse.
model Solicitud {
  id                  String              @id @default(uuid()) @db.Uuid
  empresaId           String              @map("empresa_id") @db.Uuid
  numero              Int                 @default(autoincrement())
  clase               ClaseSolicitud
  operacion           Operacion           @default(CARGA)
  clienteId           String              @map("cliente_id") @db.Uuid
  fechaSolicitada     DateTime            @map("fecha_solicitada") @db.Date // fecha aprox. de servicio / de descarga
  franjaHoraria       String?             @map("franja_horaria") @db.VarChar(20) // (fase 1) la jornada va por línea
  // Aprobación comercial (distinta del avance operativo)
  aprobacion          AprobacionSolicitud @default(PENDIENTE)
  aprobadaPorId       String?             @map("aprobada_por") @db.Uuid
  aprobadaEn          DateTime?           @map("aprobada_en") @db.Timestamptz
  estado              EstadoSolicitud     @default(PENDIENTE) // lo calcula la base a partir de las líneas
  causalCancelacionId String?             @map("causal_cancelacion_id") @db.Uuid
  ordenCompra         String?             @map("orden_compra") @db.VarChar(40)
  adjuntoUrl          String?             @map("adjunto_url")
  observaciones       String?
  notificarCliente    Boolean             @default(false) @map("notificar_cliente") // enviar las observaciones al cliente
  // Descarga en planta
  destinoId           String?             @map("destino_id") @db.Uuid // planta o gestor que recibe
  transporteId        String?             @map("transporte_id") @db.Uuid // vehículo y tripulación de terceros
  telefonoContacto    String?             @map("telefono_contacto") @db.VarChar(20)
  // Recurrencia (clase PRE)
  fechaActivacion     DateTime?           @map("fecha_activacion") @db.Date
  manifiestoOrigenId  String?             @map("manifiesto_origen_id") @db.Uuid
  totalEstimado       Decimal?            @map("total_estimado") @db.Decimal(14, 2)
  creadoPorId         String?             @map("creado_por") @db.Uuid
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz

  empresa          Empresa            @relation(fields: [empresaId], references: [id])
  cliente          Cliente            @relation(fields: [clienteId], references: [id])
  causal           CatalogoItem?      @relation("CausalCancelacion", fields: [causalCancelacionId], references: [id])
  creadoPor        Usuario?           @relation(fields: [creadoPorId], references: [id])
  aprobadaPor      Usuario?           @relation("SolAprobadaPor", fields: [aprobadaPorId], references: [id])
  destino          Proveedor?         @relation(fields: [destinoId], references: [id])
  transporte       TransporteTercero? @relation(fields: [transporteId], references: [id])
  manifiestoOrigen Manifiesto?        @relation("SolicitudRecurrente", fields: [manifiestoOrigenId], references: [id])
  items            SolicitudItem[]

  @@index([empresaId, fechaSolicitada])
  @@index([empresaId, aprobacion, estado])
  @@map("solicitudes")
}

model SolicitudItem {
  id                String              @id @default(uuid()) @db.Uuid
  solicitudId       String              @map("solicitud_id") @db.Uuid
  declaracionId     String              @map("declaracion_id") @db.Uuid // autorizada, activa y asignada a la sede
  sucursalId        String              @map("sucursal_id") @db.Uuid // sede donde se recoge
  jornada           Jornada?
  estado            EstadoItemSolicitud @default(PENDIENTE)
  causalDescarteId  String?             @map("causal_descarte_id") @db.Uuid
  cantidadEstimada  Decimal?            @map("cantidad_estimada") @db.Decimal(12, 2)
  cantidadReal      Decimal?            @map("cantidad_real") @db.Decimal(12, 2) // pesaje en campo
  cantidadEmbalajes Int?                @map("cantidad_embalajes")
  precioUnitario    Decimal?            @map("precio_unitario") @db.Decimal(14, 2) // congelado al crear
  observaciones     String?             @db.VarChar(300) // especificaciones en texto libre

  solicitud        Solicitud                     @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  declaracion      Declaracion                   @relation(fields: [declaracionId], references: [id])
  sucursal         Sucursal                      @relation(fields: [sucursalId], references: [id])
  causalDescarte   CatalogoItem?                 @relation(fields: [causalDescarteId], references: [id])
  especificaciones SolicitudItemEspecificacion[]
  rutaItems        RutaItem[]
  manifiestoItems  ManifiestoItem[]

  @@index([solicitudId])
  @@index([estado])
  @@map("solicitud_items")
}

/// Especificaciones adicionales del servicio (cadena de custodia, destrucción certificada…).
model EspecificacionAdicional {
  id          String  @id @default(uuid()) @db.Uuid
  empresaId   String  @map("empresa_id") @db.Uuid
  codigo      String  @db.VarChar(20)
  nombre      String  @db.VarChar(100)
  descripcion String?
  abreviatura String? @db.VarChar(10)
  activo      Boolean @default(true)

  empresa         Empresa                        @relation(fields: [empresaId], references: [id])
  solicitudItems  SolicitudItemEspecificacion[]
  manifiestoItems ManifiestoItemEspecificacion[]

  @@unique([empresaId, codigo])
  @@map("especificaciones_adicionales")
}

model SolicitudItemEspecificacion {
  solicitudItemId  String                  @map("solicitud_item_id") @db.Uuid
  especificacionId String                  @map("especificacion_id") @db.Uuid
  solicitudItem    SolicitudItem           @relation(fields: [solicitudItemId], references: [id], onDelete: Cascade)
  especificacion   EspecificacionAdicional @relation(fields: [especificacionId], references: [id])

  @@id([solicitudItemId, especificacionId])
  @@map("solicitud_item_especificaciones")
}

/// ARL y EPS (entidades nacionales: catálogo global).
model EntidadSeguridadSocial {
  id     String              @id @default(uuid()) @db.Uuid
  tipo   TipoSeguridadSocial
  nombre String              @db.VarChar(120)
  nit    String?             @db.VarChar(15)
  activo Boolean             @default(true)

  usuariosArl    Usuario[]           @relation("UsuarioArl")
  usuariosEps    Usuario[]           @relation("UsuarioEps")
  conductoresArl TransporteTercero[] @relation("TerceroConductorArl")
  conductoresEps TransporteTercero[] @relation("TerceroConductorEps")
  auxiliaresArl  TransporteTercero[] @relation("TerceroAuxiliarArl")
  auxiliaresEps  TransporteTercero[] @relation("TerceroAuxiliarEps")

  @@unique([tipo, nombre])
  @@map("entidades_seguridad_social")
}

/// Vehículo y tripulación de un tercero que entrega en planta (descargas). Datos personales: Ley 1581/2012.
model TransporteTercero {
  id                    String   @id @default(uuid()) @db.Uuid
  empresaId             String   @map("empresa_id") @db.Uuid
  empresaTransportadora String   @map("empresa_transportadora") @db.VarChar(200)
  tipoVehiculo          String?  @map("tipo_vehiculo") @db.VarChar(40)
  placa                 String?  @db.VarChar(7)
  conductorNombre       String?  @map("conductor_nombre") @db.VarChar(150)
  conductorDocumento    String?  @map("conductor_documento") @db.VarChar(20)
  conductorArlId        String?  @map("conductor_arl_id") @db.Uuid
  conductorEpsId        String?  @map("conductor_eps_id") @db.Uuid
  auxiliarNombre        String?  @map("auxiliar_nombre") @db.VarChar(150)
  auxiliarDocumento     String?  @map("auxiliar_documento") @db.VarChar(20)
  auxiliarArlId         String?  @map("auxiliar_arl_id") @db.Uuid
  auxiliarEpsId         String?  @map("auxiliar_eps_id") @db.Uuid
  telefono              String?  @db.VarChar(20)
  nit                   String?  @db.VarChar(15) // NIT de la empresa transportadora
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz

  empresa      Empresa                 @relation(fields: [empresaId], references: [id])
  conductorArl EntidadSeguridadSocial? @relation("TerceroConductorArl", fields: [conductorArlId], references: [id])
  conductorEps EntidadSeguridadSocial? @relation("TerceroConductorEps", fields: [conductorEpsId], references: [id])
  auxiliarArl  EntidadSeguridadSocial? @relation("TerceroAuxiliarArl", fields: [auxiliarArlId], references: [id])
  auxiliarEps  EntidadSeguridadSocial? @relation("TerceroAuxiliarEps", fields: [auxiliarEpsId], references: [id])
  solicitudes  Solicitud[]
  manifiestos  Manifiesto[]

  @@map("transportes_terceros")
}

/// Consecutivos de documentos por empresa (manifiesto, inspección, acta). El formato lo define Terra Viva.
model Consecutivo {
  empresaId     String  @map("empresa_id") @db.Uuid
  documento     String  @db.VarChar(20) // MANIFIESTO | INSPECCION | ACTA
  prefijo       String  @default("") @db.VarChar(10)
  digitos       Int     @default(5) @db.SmallInt
  reinicioAnual Boolean @default(true) @map("reinicio_anual")
  anio          Int     @db.SmallInt
  ultimo        Int     @default(0)

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@id([empresaId, documento])
  @@map("consecutivos")
}

model EstadoRecorrido {
  id          String       @id @default(uuid()) @db.Uuid
  empresaId   String       @map("empresa_id") @db.Uuid
  nombre      String       @db.VarChar(40) // En camino, En sitio, Finalizada, Cancelada (configurables)
  descripcion String?      @db.VarChar(200)
  color       String       @db.VarChar(7)
  orden       Int
  esFinal     Boolean      @default(false) @map("es_final")
  cancela     Boolean      @default(false) // al entrar, la ruta se cancela y sus líneas sin realizar vuelven a pendientes
  rastreo     Boolean      @default(false) // GPS continuo mientras la ruta esté en esta etapa (Ley 1581: solo en jornada)
  activo      Boolean      @default(true)
  empresa     Empresa      @relation(fields: [empresaId], references: [id])
  rutas       Ruta[]
  eventos     RutaEvento[]

  @@map("estados_recorrido")
}

/// Ruta programada. Puede crearse sin vehículo o conductor («sin recursos»), pero no sale sin ellos.
model Ruta {
  id                String    @id @default(uuid()) @db.Uuid
  empresaId         String    @map("empresa_id") @db.Uuid
  codigo            String    @db.VarChar(20)
  fechaProgramada   DateTime  @map("fecha_programada") @db.Date
  horaProgramada    DateTime? @map("hora_programada") @db.Time(0)
  zonaId            String?   @map("zona_id") @db.Uuid
  vehiculoId        String?   @map("vehiculo_id") @db.Uuid
  conductorId       String?   @map("conductor_id") @db.Uuid
  auxiliarId        String?   @map("auxiliar_id") @db.Uuid
  estadoRecorridoId String?   @map("estado_recorrido_id") @db.Uuid
  interna           Boolean   @default(false) // movimiento dentro de la planta
  valorFlete        Decimal?  @map("valor_flete") @db.Decimal(14, 2) // vehículo de tercero
  // Recurrencia: la ruta base genera rutas futuras cada «frecuenciaDias»
  frecuenciaDias    Int?      @map("frecuencia_dias")
  recurrenteActiva  Boolean   @default(false) @map("recurrente_activa")
  rutaBaseId        String?   @map("ruta_base_id") @db.Uuid
  kmInicial         Int?      @map("km_inicial")
  kmFinal           Int?      @map("km_final")
  horaSalida        DateTime? @map("hora_salida") @db.Timestamptz
  horaLlegadaPlanta DateTime? @map("hora_llegada_planta") @db.Timestamptz
  observaciones     String?

  empresa          Empresa          @relation(fields: [empresaId], references: [id])
  zona             Zona?            @relation(fields: [zonaId], references: [id])
  vehiculo         Vehiculo?        @relation(fields: [vehiculoId], references: [id])
  conductor        Usuario?         @relation("RutaConductor", fields: [conductorId], references: [id])
  auxiliar         Usuario?         @relation("RutaAuxiliar", fields: [auxiliarId], references: [id])
  estadoRecorrido  EstadoRecorrido? @relation(fields: [estadoRecorridoId], references: [id])
  rutaBase         Ruta?            @relation("RutaRecurrente", fields: [rutaBaseId], references: [id])
  generadas        Ruta[]           @relation("RutaRecurrente")
  paradas          RutaParada[]
  items            RutaItem[]
  rastreo          RutaRastreo[]
  eventos          RutaEvento[]
  preoperacionales Preoperacional[]
  manifiestos      Manifiesto[]
  gps              RutaGps?
  paradasGps       ParadaGps[]
  eventosGps       EventoGps[]

  @@unique([empresaId, codigo])
  @@index([fechaProgramada, vehiculoId])
  @@map("rutas")
}

/// Parada de la ruta en una sede. Lo que se recoge ahí está en ruta_items.
model RutaParada {
  id            String       @id @default(uuid()) @db.Uuid
  rutaId        String       @map("ruta_id") @db.Uuid
  sucursalId    String       @map("sucursal_id") @db.Uuid
  orden         Int          @db.SmallInt
  horaLlegada   DateTime?    @map("hora_llegada") @db.Timestamptz
  latCheckin    Decimal?     @map("lat_checkin") @db.Decimal(9, 6)
  lngCheckin    Decimal?     @map("lng_checkin") @db.Decimal(9, 6)
  estado        EstadoParada @default(PENDIENTE)
  observaciones String?

  ruta     Ruta       @relation(fields: [rutaId], references: [id], onDelete: Cascade)
  sucursal Sucursal   @relation(fields: [sucursalId], references: [id])
  items    RutaItem[]
  gps      ParadaGps?

  @@unique([rutaId, orden])
  @@map("ruta_paradas")
}

/// Programación por línea: qué línea de qué solicitud se recoge en qué parada.
/// Una línea solo puede estar en una ruta vigente (índice parcial «liberado = false» en SQL).
model RutaItem {
  id              String   @id @default(uuid()) @db.Uuid
  rutaId          String   @map("ruta_id") @db.Uuid
  paradaId        String   @map("parada_id") @db.Uuid
  solicitudItemId String   @map("solicitud_item_id") @db.Uuid
  liberado        Boolean  @default(false) // ruta cancelada o manifiesto anulado: la línea vuelve a pendiente
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  ruta          Ruta          @relation(fields: [rutaId], references: [id], onDelete: Cascade)
  parada        RutaParada    @relation(fields: [paradaId], references: [id], onDelete: Cascade)
  solicitudItem SolicitudItem @relation(fields: [solicitudItemId], references: [id])

  @@index([solicitudItemId])
  @@map("ruta_items")
}

/// Historial de etapas de cada ruta (lo llena la base al cambiar la etapa). Sirve para aceptar puntos
/// GPS que llegan tarde (celular sin señal) y para los tiempos de los informes.
model RutaEvento {
  id                BigInt   @id @default(autoincrement())
  rutaId            String   @map("ruta_id") @db.Uuid
  estadoRecorridoId String?  @map("estado_recorrido_id") @db.Uuid
  desde             DateTime @default(now()) @db.Timestamptz

  ruta            Ruta             @relation(fields: [rutaId], references: [id], onDelete: Cascade)
  estadoRecorrido EstadoRecorrido? @relation(fields: [estadoRecorridoId], references: [id])

  @@index([rutaId, desde])
  @@map("ruta_eventos")
}

/// Puntos GPS. Solo se aceptan si a la hora del punto la ruta estaba en una etapa con rastreo (regla en la base).
model RutaRastreo {
  id           BigInt   @id @default(autoincrement())
  rutaId       String   @map("ruta_id") @db.Uuid
  vehiculoId   String?  @map("vehiculo_id") @db.Uuid
  latitud      Decimal  @db.Decimal(9, 6)
  longitud     Decimal  @db.Decimal(9, 6)
  precisionM   Decimal? @map("precision_m") @db.Decimal(7, 1)
  velocidadKmh Decimal? @map("velocidad_kmh") @db.Decimal(5, 1)
  registradoEn DateTime @map("registrado_en") @db.Timestamptz // hora del teléfono (puede llegar tarde sin señal)
  recibidoEn   DateTime @default(now()) @map("recibido_en") @db.Timestamptz
  fuente       String   @default("CELULAR") @db.VarChar(8) // CELULAR | WIALON (el mismo punto de Wialon no se repite)

  ruta     Ruta      @relation(fields: [rutaId], references: [id], onDelete: Cascade)
  vehiculo Vehiculo? @relation(fields: [vehiculoId], references: [id])

  @@index([rutaId, registradoEn])
  @@map("ruta_rastreo")
}

// ---------------------------------------------------------------------
// HSEQ Y DOCUMENTACIÓN
// ---------------------------------------------------------------------
model ElementoChequeo {
  id         String           @id @default(uuid()) @db.Uuid
  empresaId  String           @map("empresa_id") @db.Uuid
  grupo      String           @db.VarChar(60) // Documentos, Luces, Llantas, Kit derrames, EPP…
  nombre     String           @db.VarChar(150)
  critico    Boolean          @default(false) // si falla, la ruta NO puede salir
  activo     Boolean          @default(true)
  empresa    Empresa          @relation(fields: [empresaId], references: [id])
  respuestas PreopRespuesta[]

  @@map("elementos_chequeo")
}

model Preoperacional {
  id              String    @id @default(uuid()) @db.Uuid
  numero          String    @default("") @db.VarChar(20) // consecutivo: lo asigna la base al crear
  vehiculoId      String    @map("vehiculo_id") @db.Uuid
  rutaId          String?   @map("ruta_id") @db.Uuid
  conductorId     String    @map("conductor_id") @db.Uuid
  auxiliarId      String?   @map("auxiliar_id") @db.Uuid
  fechaProgramada DateTime  @map("fecha_programada") @db.Date
  fechaReal       DateTime? @map("fecha_real") @db.Timestamptz
  km              Int?
  aprobado        Boolean?
  observaciones   String?
  firmaUrl        String?   @map("firma_url")

  vehiculo   Vehiculo         @relation(fields: [vehiculoId], references: [id])
  ruta       Ruta?            @relation(fields: [rutaId], references: [id])
  conductor  Usuario          @relation("PreopConductor", fields: [conductorId], references: [id])
  auxiliar   Usuario?         @relation("PreopAuxiliar", fields: [auxiliarId], references: [id])
  respuestas PreopRespuesta[]

  @@unique([vehiculoId, numero], map: "ux_preoperacional_numero")
  @@map("preoperacionales")
}

model PreopRespuesta {
  preoperacionalId String           @map("preoperacional_id") @db.Uuid
  elementoId       String           @map("elemento_id") @db.Uuid
  resultado        ResultadoChequeo
  fotoUrl          String?          @map("foto_url")
  observacion      String?          @db.VarChar(300)
  preoperacional   Preoperacional   @relation(fields: [preoperacionalId], references: [id], onDelete: Cascade)
  elemento         ElementoChequeo  @relation(fields: [elementoId], references: [id])

  @@id([preoperacionalId, elementoId])
  @@map("preop_respuestas")
}

/// Manifiesto de cargue (con ruta) o de descargue (entrega en planta). Un solo consecutivo para ambos.
/// Al pasar a REALIZADO (firma, horas, báscula) la base crea la conciliación en borrador.
model Manifiesto {
  id                String           @id @default(uuid()) @db.Uuid
  empresaId         String           @map("empresa_id") @db.Uuid
  numero            String           @default("") @db.VarChar(20) // consecutivo: lo asigna la base al crear
  tipo              TipoManifiesto   @default(CARGUE)
  estado            EstadoManifiesto @default(PENDIENTE)
  rutaId            String?          @map("ruta_id") @db.Uuid // solo cargue
  clienteId         String           @map("cliente_id") @db.Uuid
  destinoId         String           @map("destino_id") @db.Uuid // planta o sede que recibe
  tipoConciliacion  TipoConciliacion @default(INTERNA) @map("tipo_conciliacion")
  fechaServicio     DateTime         @map("fecha_servicio") @db.Date
  ordenCompra       String?          @map("orden_compra") @db.VarChar(40)
  manifiestoCliente String?          @map("manifiesto_cliente") @db.VarChar(40) // número del documento del cliente
  // Tripulación: propia (cargue) o de terceros (descargue)
  vehiculoId        String?          @map("vehiculo_id") @db.Uuid
  conductorId       String?          @map("conductor_id") @db.Uuid
  auxiliarId        String?          @map("auxiliar_id") @db.Uuid
  transporteId      String?          @map("transporte_id") @db.Uuid
  // Báscula (kg). Neto = entrada − salida
  pesoEntrada       Decimal?         @map("peso_entrada") @db.Decimal(12, 2)
  pesoSalida        Decimal?         @map("peso_salida") @db.Decimal(12, 2)
  pesoNeto          Decimal?         @map("peso_neto") @db.Decimal(12, 2)
  horaLlegada       DateTime?        @map("hora_llegada") @db.Timestamptz
  horaSalida        DateTime?        @map("hora_salida") @db.Timestamptz
  observaciones     String?
  // Cierre: firma táctil del conductor
  firmaUrl          String?          @map("firma_url")
  firmaNombre       String?          @map("firma_nombre") @db.VarChar(150)
  firmaDocumento    String?          @map("firma_documento") @db.VarChar(20)
  realizadoEn       DateTime?        @map("realizado_en") @db.Timestamptz
  realizadoPorId    String?          @map("realizado_por") @db.Uuid
  // Anulación
  causalAnulacionId String?          @map("causal_anulacion_id") @db.Uuid
  motivoAnulacion   String?          @map("motivo_anulacion") @db.VarChar(300)
  anuladoEn         DateTime?        @map("anulado_en") @db.Timestamptz
  anuladoPorId      String?          @map("anulado_por") @db.Uuid
  consecutivoRndc   String?          @map("consecutivo_rndc") @db.VarChar(30)
  pdfUrl            String?          @map("pdf_url")
  // Recepción en planta (descargue): firma del receptor de Terra Viva además de la del conductor o el cliente
  receptorId        String?          @map("receptor_id") @db.Uuid
  receptorNombre    String?          @map("receptor_nombre") @db.VarChar(150)
  receptorDocumento String?          @map("receptor_documento") @db.VarChar(20)
  firmaReceptorUrl  String?          @map("firma_receptor_url")
  creadoPorId       String?          @map("creado_por") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz

  empresa         Empresa               @relation(fields: [empresaId], references: [id])
  ruta            Ruta?                 @relation(fields: [rutaId], references: [id])
  cliente         Cliente               @relation(fields: [clienteId], references: [id])
  destino         Proveedor             @relation(fields: [destinoId], references: [id])
  vehiculo        Vehiculo?             @relation(fields: [vehiculoId], references: [id])
  conductor       Usuario?              @relation("MfConductor", fields: [conductorId], references: [id])
  auxiliar        Usuario?              @relation("MfAuxiliar", fields: [auxiliarId], references: [id])
  transporte      TransporteTercero?    @relation(fields: [transporteId], references: [id])
  realizadoPor    Usuario?              @relation("MfRealizadoPor", fields: [realizadoPorId], references: [id])
  causalAnulacion CatalogoItem?         @relation("CausalAnulacionMf", fields: [causalAnulacionId], references: [id])
  anuladoPor      Usuario?              @relation("MfAnuladoPor", fields: [anuladoPorId], references: [id])
  creadoPor       Usuario?              @relation("MfCreadoPor", fields: [creadoPorId], references: [id])
  receptor        Usuario?              @relation("MfReceptor", fields: [receptorId], references: [id])
  items           ManifiestoItem[]
  evidencias      ManifiestoEvidencia[]
  conciliacion    Conciliacion?
  recurrentes     Solicitud[]           @relation("SolicitudRecurrente")
  // Facturación (tablas aparte: solo las leen los módulos de finanzas, nunca las pantallas de campo ni el portal)
  facturas        FacturaManifiesto[]
  finanzas        ManifiestoFinanzas?

  @@unique([empresaId, numero])
  @@index([empresaId, estado, fechaServicio])
  @@map("manifiestos")
}

/// Línea del manifiesto. Puede venir de una línea de solicitud o agregarse en campo
/// (siempre con una declaración autorizada, activa y asignada al generador).
model ManifiestoItem {
  id              String   @id @default(uuid()) @db.Uuid
  manifiestoId    String   @map("manifiesto_id") @db.Uuid
  solicitudItemId String?  @map("solicitud_item_id") @db.Uuid
  declaracionId   String   @map("declaracion_id") @db.Uuid
  sucursalId      String   @map("sucursal_id") @db.Uuid // generador
  cantidad        Decimal  @map("cantidad_origen") @db.Decimal(12, 2)
  metricaId       String?  @map("metrica_id") @db.Uuid
  disposicionId   String?  @map("disposicion_id") @db.Uuid
  tipoEmbalajeId  String?  @map("tipo_embalaje_id") @db.Uuid
  embalajes       Int?
  precioUnitario  Decimal? @map("precio_unitario") @db.Decimal(14, 2) // tarifa vigente al crear la línea
  observaciones   String?  @db.VarChar(300)

  manifiesto       Manifiesto                     @relation(fields: [manifiestoId], references: [id], onDelete: Cascade)
  solicitudItem    SolicitudItem?                 @relation(fields: [solicitudItemId], references: [id])
  declaracion      Declaracion                    @relation(fields: [declaracionId], references: [id])
  sucursal         Sucursal                       @relation(fields: [sucursalId], references: [id])
  metrica          Metrica?                       @relation(fields: [metricaId], references: [id])
  disposicion      Disposicion?                   @relation(fields: [disposicionId], references: [id])
  tipoEmbalaje     TipoEmbalaje?                  @relation(fields: [tipoEmbalajeId], references: [id])
  especificaciones ManifiestoItemEspecificacion[]
  conciliacion     ConciliacionItem?

  @@index([manifiestoId])
  @@map("manifiesto_items")
}

model ManifiestoItemEspecificacion {
  manifiestoItemId String                  @map("manifiesto_item_id") @db.Uuid
  especificacionId String                  @map("especificacion_id") @db.Uuid
  manifiestoItem   ManifiestoItem          @relation(fields: [manifiestoItemId], references: [id], onDelete: Cascade)
  especificacion   EspecificacionAdicional @relation(fields: [especificacionId], references: [id])

  @@id([manifiestoItemId, especificacionId])
  @@map("manifiesto_item_especificaciones")
}

/// Fotos desde la cámara del celular (máx. 2) y PDF escaneado (máx. 1).
model ManifiestoEvidencia {
  id            String        @id @default(uuid()) @db.Uuid
  manifiestoId  String        @map("manifiesto_id") @db.Uuid
  tipo          TipoEvidencia
  url           String
  nombreArchivo String?       @map("nombre_archivo") @db.VarChar(200)
  bytes         Int?
  tomadaEn      DateTime?     @map("tomada_en") @db.Timestamptz
  latitud       Decimal?      @db.Decimal(9, 6)
  longitud      Decimal?      @db.Decimal(9, 6)
  subidaPorId   String?       @map("subida_por") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz

  manifiesto Manifiesto @relation(fields: [manifiestoId], references: [id], onDelete: Cascade)
  subidaPor  Usuario?   @relation(fields: [subidaPorId], references: [id])

  @@index([manifiestoId])
  @@map("manifiesto_evidencias")
}

/// Conciliación de un manifiesto realizado: cantidades finales y dinero. Al aprobarla se habilita el acta.
model Conciliacion {
  id            String             @id @default(uuid()) @db.Uuid
  empresaId     String             @map("empresa_id") @db.Uuid
  manifiestoId  String             @unique @map("manifiesto_id") @db.Uuid
  estado        EstadoConciliacion @default(BORRADOR)
  aprobadaPorId String?            @map("aprobada_por") @db.Uuid
  aprobadaEn    DateTime?          @map("aprobada_en") @db.Timestamptz
  observaciones String?
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz

  empresa     Empresa            @relation(fields: [empresaId], references: [id])
  manifiesto  Manifiesto         @relation(fields: [manifiestoId], references: [id], onDelete: Cascade)
  aprobadaPor Usuario?           @relation(fields: [aprobadaPorId], references: [id])
  items       ConciliacionItem[]

  @@index([empresaId, estado])
  @@map("conciliaciones")
}

/// Línea conciliada. La diferencia cargada/conciliada de más de ±2 % exige justificación (CHECK en la base).
/// Después de aprobar solo cambian los datos de factura y pago (cartera).
model ConciliacionItem {
  id                 String           @id @default(uuid()) @db.Uuid
  conciliacionId     String           @map("conciliacion_id") @db.Uuid
  manifiestoItemId   String           @unique @map("manifiesto_item_id") @db.Uuid
  actaId             String?          @map("acta_id") @db.Uuid // acta que la certifica
  cantidadCargada    Decimal          @map("cantidad_origen") @db.Decimal(12, 2)
  cantidadConciliada Decimal?         @map("cantidad_destino") @db.Decimal(12, 2) // báscula de planta / acordada
  metricaId          String?          @map("metrica_id") @db.Uuid
  precioUnitario     Decimal?         @map("precio_unitario") @db.Decimal(14, 2)
  tipoNegociacion    TipoNegociacion? @map("tipo_negociacion")
  formaPago          FormaPago?       @map("forma_pago")
  disposicionId      String?          @map("disposicion_id") @db.Uuid
  ordenCompra        String?          @map("orden_compra") @db.VarChar(40)
  facturaNumero      String?          @map("factura_numero") @db.VarChar(30)
  facturaEmision     DateTime?        @map("factura_emision") @db.Date
  facturaVencimiento DateTime?        @map("factura_vencimiento") @db.Date
  estadoPago         EstadoPago       @default(PENDIENTE) @map("estado_pago")
  justificacion      String?
  certificadoAliado  String?          @map("certificado_aliado") @db.VarChar(60) // N.° del certificado del gestor aliado

  conciliacion   Conciliacion   @relation(fields: [conciliacionId], references: [id], onDelete: Cascade)
  manifiestoItem ManifiestoItem @relation(fields: [manifiestoItemId], references: [id])
  acta           Acta?          @relation(fields: [actaId], references: [id])
  metrica        Metrica?       @relation(fields: [metricaId], references: [id])
  disposicion    Disposicion?   @relation(fields: [disposicionId], references: [id])

  @@index([conciliacionId])
  @@index([actaId])
  @@map("conciliacion_items")
}

/// Acta / certificado de disposición final. Solo certifica líneas de conciliaciones aprobadas.
/// Al emitirla se guarda en «contenido» una copia fija de lo certificado (cantidades, tratamientos y
/// permisos vigentes), para que el certificado no cambie si después cambian los datos.
model Acta {
  id                    String     @id @default(uuid()) @db.Uuid
  empresaId             String     @map("empresa_id") @db.Uuid
  numero                String     @default("") @db.VarChar(20) // consecutivo: lo asigna la base al crear
  tipo                  TipoActa
  origen                OrigenActa @default(GENERADA)
  clienteId             String     @map("cliente_id") @db.Uuid
  destinoId             String     @map("destino_id") @db.Uuid
  periodoDesde          DateTime   @map("periodo_desde") @db.Date
  periodoHasta          DateTime   @map("periodo_hasta") @db.Date
  estado                EstadoActa @default(BORRADOR)
  codigoVerificacion    String     @unique @default(dbgenerated("encode(gen_random_bytes(12), 'hex'::text)")) @map("codigo_verificacion") @db.VarChar(32) // va en el QR
  contenido             Json? // copia fija de lo certificado, al emitir
  emitidaEn             DateTime?  @map("emitida_en") @db.Timestamptz
  emitidaPorId          String?    @map("emitida_por") @db.Uuid
  pdfUrl                String?    @map("pdf_url")
  pdfSha256             String?    @map("pdf_sha256") @db.Char(64) // integridad del PDF emitido
  // Certificado por generador (clientes GESTOR): la razón social del certificado es la del generador
  generadorNit          String?    @map("generador_nit") @db.VarChar(15)
  generadorNombre       String?    @map("generador_nombre") @db.VarChar(200)
  archivoUrl            String?    @map("archivo_url") // acta CARGADA de un gestor aliado
  cargadaPorId          String?    @map("cargada_por") @db.Uuid
  motivoAnulacion       String?    @map("motivo_anulacion") @db.VarChar(300)
  anuladaEn             DateTime?  @map("anulada_en") @db.Timestamptz
  // Portal: con una factura vencida y sin pagar el cliente no descarga el certificado, salvo que la oficina lo libere
  descargaLiberadaEn    DateTime?  @map("descarga_liberada_en") @db.Timestamptz
  descargaLiberadaPorId String?    @map("descarga_liberada_por") @db.Uuid
  createdAt             DateTime   @default(now()) @map("created_at") @db.Timestamptz

  empresa             Empresa            @relation(fields: [empresaId], references: [id])
  cliente             Cliente            @relation(fields: [clienteId], references: [id])
  destino             Proveedor          @relation(fields: [destinoId], references: [id])
  emitidaPor          Usuario?           @relation("ActaEmitidaPor", fields: [emitidaPorId], references: [id])
  cargadaPor          Usuario?           @relation("ActaCargadaPor", fields: [cargadaPorId], references: [id])
  descargaLiberadaPor Usuario?           @relation("ActaDescargaLiberada", fields: [descargaLiberadaPorId], references: [id])
  items               ConciliacionItem[]

  @@unique([empresaId, numero])
  @@map("actas")
}

// ---------------------------------------------------------------------
// AUDITORÍA (Ley 1581/2012 y soporte ante autoridad)
// ---------------------------------------------------------------------
/// Cola de trabajos (requisitos de producción §1): ZIP y Excel que se preparan aparte y se descargan con un enlace
/// firmado de 5 minutos. Cada copia del API toma un trabajo con FOR UPDATE SKIP LOCKED. El archivo preparado vence.
model Trabajo {
  id           String        @id @default(uuid()) @db.Uuid
  empresaId    String        @map("empresa_id") @db.Uuid
  usuarioId    String        @map("usuario_id") @db.Uuid
  tipo         String        @db.VarChar(40) // ZIP_ACTAS, EXCEL_CONCILIACION, EXCEL_COSTOS_RUTAS…
  titulo       String        @db.VarChar(200)
  parametros   Json          @default("{}")
  estado       EstadoTrabajo @default(PENDIENTE)
  intentos     Int           @default(0) @db.SmallInt
  error        String?       @db.VarChar(500)
  archivo      String? // clave del archivo preparado
  nombre       String?       @db.VarChar(200)
  bytes        Int?
  creadoEn     DateTime      @default(now()) @map("creado_en") @db.Timestamptz
  iniciadoEn   DateTime?     @map("iniciado_en") @db.Timestamptz
  terminadoEn  DateTime?     @map("terminado_en") @db.Timestamptz
  venceEn      DateTime?     @map("vence_en") @db.Timestamptz
  descargadoEn DateTime?     @map("descargado_en") @db.Timestamptz

  empresa Empresa @relation(fields: [empresaId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId, creadoEn(sort: Desc)], map: "ix_trabajos_usuario")
  @@map("trabajos")
}

/// Tarea que corre una vez al día por empresa (correo de alertas): la llave decide qué copia del API la hace.
model TareaDiaria {
  empresaId   String    @map("empresa_id") @db.Uuid
  tarea       String    @db.VarChar(40)
  dia         DateTime  @db.Date
  iniciadaEn  DateTime  @default(now()) @map("iniciada_en") @db.Timestamptz
  terminadaEn DateTime? @map("terminada_en") @db.Timestamptz
  detalle     Json      @default("{}")

  @@id([empresaId, tarea, dia])
  @@map("tareas_diarias")
}

/// Error inesperado del servidor (respondió «Error interno»): para el aviso al administrador y la alerta de seguridad.
model ErrorServidor {
  id        BigInt   @id @default(autoincrement())
  fecha     DateTime @default(now()) @db.Timestamptz
  empresaId String?  @map("empresa_id") @db.Uuid
  usuarioId String?  @map("usuario_id") @db.Uuid
  metodo    String   @db.VarChar(10)
  ruta      String   @db.VarChar(300)
  mensaje   String   @db.VarChar(500)
  firma     String   @db.Char(16) // agrupa los repetidos
  avisado   Boolean  @default(false)
  ip        String?  @db.VarChar(64)

  @@index([fecha(sort: Desc)], map: "ix_errores_servidor_fecha")
  @@index([firma, fecha(sort: Desc)], map: "ix_errores_servidor_firma")
  @@map("errores_servidor")
}

/// Última posición de cada vehículo traída de Wialon (se reescribe en cada consulta; no es evidencia).
model VehiculoGps {
  vehiculoId    String   @id @map("vehiculo_id") @db.Uuid
  unidadId      Int      @map("unidad_id")
  latitud       Decimal  @db.Decimal(9, 6)
  longitud      Decimal  @db.Decimal(9, 6)
  velocidadKmh  Decimal? @map("velocidad_kmh") @db.Decimal(5, 1)
  rumbo         Int?     @db.SmallInt
  posicionEn    DateTime @map("posicion_en") @db.Timestamptz // hora del GPS
  actualizadoEn DateTime @default(now()) @map("actualizado_en") @db.Timestamptz

  vehiculo Vehiculo @relation(fields: [vehiculoId], references: [id])

  @@map("vehiculos_gps")
}

/// Resumen GPS de una ruta con Wialon: salida y llegada a la planta, kilómetros, puntos y estado de los detectores.
model RutaGps {
  rutaId         String    @id @map("ruta_id") @db.Uuid
  vehiculoId     String    @map("vehiculo_id") @db.Uuid
  unidadId       Int       @map("unidad_id")
  procesadoHasta DateTime  @map("procesado_hasta") @db.Timestamptz // hora del último mensaje de Wialon procesado
  puntos         Int       @default(0)
  km             Decimal   @default(0) @db.Decimal(9, 2)
  salidaPlanta   DateTime? @map("salida_planta") @db.Timestamptz
  llegadaPlanta  DateTime? @map("llegada_planta") @db.Timestamptz
  estado         Json      @default("{}")
  cerrada        Boolean   @default(false) // la ruta terminó y ya se procesó su último tramo
  actualizadoEn  DateTime  @default(now()) @map("actualizado_en") @db.Timestamptz

  ruta     Ruta     @relation(fields: [rutaId], references: [id], onDelete: Cascade)
  vehiculo Vehiculo @relation(fields: [vehiculoId], references: [id])

  @@map("rutas_gps")
}

/// Llegada, salida y tiempo en sitio de una parada según la geocerca de la sede (Wialon).
model ParadaGps {
  paradaId        String    @id @map("parada_id") @db.Uuid
  rutaId          String    @map("ruta_id") @db.Uuid
  llegada         DateTime? @db.Timestamptz
  salida          DateTime? @db.Timestamptz
  dentroDesde     DateTime? @map("dentro_desde") @db.Timestamptz // visita en curso
  segundosEnSitio Int       @default(0) @map("segundos_en_sitio")
  actualizadoEn   DateTime  @default(now()) @map("actualizado_en") @db.Timestamptz

  parada RutaParada @relation(fields: [paradaId], references: [id], onDelete: Cascade)
  ruta   Ruta       @relation(fields: [rutaId], references: [id], onDelete: Cascade)

  @@index([rutaId], map: "ix_paradas_gps_ruta")
  @@map("paradas_gps")
}

/// Parada no programada con RESPEL o desvío de la ruta (Wialon): evidencia. Solo se cierra o se marca revisado (regla en la base).
model EventoGps {
  id          Int       @id @default(autoincrement())
  empresaId   String    @map("empresa_id") @db.Uuid
  rutaId      String    @map("ruta_id") @db.Uuid
  vehiculoId  String    @map("vehiculo_id") @db.Uuid
  tipo        String    @db.VarChar(25) // PARADA_NO_PROGRAMADA | DESVIO
  inicio      DateTime  @db.Timestamptz
  fin         DateTime? @db.Timestamptz
  latitud     Decimal   @db.Decimal(9, 6)
  longitud    Decimal   @db.Decimal(9, 6)
  conRespel   Boolean   @default(false) @map("con_respel")
  detalle     Json      @default("{}")
  revisadoPor String?   @map("revisado_por") @db.Uuid
  revisadoEn  DateTime? @map("revisado_en") @db.Timestamptz
  nota        String?   @db.VarChar(300)
  creadoEn    DateTime  @default(now()) @map("creado_en") @db.Timestamptz

  empresa  Empresa  @relation(fields: [empresaId], references: [id])
  ruta     Ruta     @relation(fields: [rutaId], references: [id])
  vehiculo Vehiculo @relation(fields: [vehiculoId], references: [id])
  revisor  Usuario? @relation("EventoGpsRevisor", fields: [revisadoPor], references: [id])

  @@index([rutaId, inicio], map: "ix_eventos_gps_ruta")
  @@map("eventos_gps")
}

/// Conexión con Wialon de cada empresa: último intento, último bien, error y unidades de la cuenta.
model WialonEstado {
  empresaId      String    @id @map("empresa_id") @db.Uuid
  ultimoIntento  DateTime? @map("ultimo_intento") @db.Timestamptz
  ultimoOk       DateTime? @map("ultimo_ok") @db.Timestamptz
  fallosSeguidos Int       @default(0) @map("fallos_seguidos")
  error          String?   @db.VarChar(300)
  ocupadoHasta   DateTime? @map("ocupado_hasta") @db.Timestamptz // evita que dos copias del API procesen a la vez
  detalle        Json      @default("{}")

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@map("wialon_estado")
}

/// Factura de venta traída de Siigo Nube (copia local para cruzarla con los manifiestos).
model FacturaSiigo {
  id                 String             @id @default(uuid()) @db.Uuid
  empresaId          String             @map("empresa_id") @db.Uuid
  siigoId            String             @map("siigo_id") @db.VarChar(60)
  nombre             String             @db.VarChar(30) // FV-2-1234
  fecha              DateTime           @db.Date
  vence              DateTime?          @db.Date
  total              Decimal            @db.Decimal(16, 2)
  saldo              Decimal            @db.Decimal(16, 2)
  notasCredito       Decimal            @default(0) @map("notas_credito") @db.Decimal(16, 2)
  estado             EstadoFacturaSiigo
  estadoDian         String?            @map("estado_dian") @db.VarChar(30)
  clienteNit         String             @map("cliente_nit") @db.VarChar(20)
  clienteId          String?            @map("cliente_id") @db.Uuid
  manifiestosCitados String[]           @default([]) @map("manifiestos_citados")
  urlPublica         String?            @map("url_publica")
  sincronizadaEn     DateTime           @default(now()) @map("sincronizada_en") @db.Timestamptz

  empresa     Empresa             @relation(fields: [empresaId], references: [id])
  cliente     Cliente?            @relation(fields: [clienteId], references: [id])
  manifiestos FacturaManifiesto[]

  @@unique([empresaId, siigoId])
  @@index([empresaId, nombre], map: "ix_facturas_siigo_nombre")
  @@map("facturas_siigo")
}

/// Qué factura cubre qué manifiesto: CITADO (la factura cita el manifiesto), NUMERO (la conciliación tiene el número) o MANUAL.
model FacturaManifiesto {
  facturaId    String   @map("factura_id") @db.Uuid
  manifiestoId String   @map("manifiesto_id") @db.Uuid
  origen       String   @db.VarChar(20)
  creadoEn     DateTime @default(now()) @map("creado_en") @db.Timestamptz
  creadoPorId  String?  @map("creado_por_id") @db.Uuid

  factura    FacturaSiigo @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  manifiesto Manifiesto   @relation(fields: [manifiestoId], references: [id])
  creadoPor  Usuario?     @relation(fields: [creadoPorId], references: [id])

  @@id([facturaId, manifiestoId])
  @@index([manifiestoId], map: "ix_factura_manifiestos_manifiesto")
  @@map("factura_manifiestos")
}

/// Estado financiero de un manifiesto realizado (lo recalcula la sincronización y cada cambio de facturación).
model ManifiestoFinanzas {
  manifiestoId  String               @id @map("manifiesto_id") @db.Uuid
  empresaId     String               @map("empresa_id") @db.Uuid
  facturado     Boolean              @default(false)
  estadoPago    EstadoPagoManifiesto @default(PENDIENTE) @map("estado_pago")
  facturas      String[]             @default([])
  saldo         Decimal?             @db.Decimal(16, 2)
  vence         DateTime?            @db.Date
  libreMotivo   String?              @map("libre_motivo") @db.VarChar(300)
  librePorId    String?              @map("libre_por_id") @db.Uuid
  libreEn       DateTime?            @map("libre_en") @db.Timestamptz
  actualizadoEn DateTime             @default(now()) @map("actualizado_en") @db.Timestamptz

  manifiesto Manifiesto @relation(fields: [manifiestoId], references: [id])
  empresa    Empresa    @relation(fields: [empresaId], references: [id])
  librePor   Usuario?   @relation(fields: [librePorId], references: [id])

  @@index([empresaId, estadoPago, facturado], map: "ix_manifiestos_finanzas")
  @@map("manifiestos_finanzas")
}

/// Cada sincronización con Siigo: AUTOMATICA (una al día) o MANUAL (botón de facturación).
model SincronizacionSiigo {
  id          String    @id @default(uuid()) @db.Uuid
  empresaId   String    @map("empresa_id") @db.Uuid
  origen      String    @db.VarChar(20)
  dia         DateTime  @db.Date
  usuarioId   String?   @map("usuario_id") @db.Uuid
  estado      String    @default("EN_CURSO") @db.VarChar(20)
  iniciadaEn  DateTime  @default(now()) @map("iniciada_en") @db.Timestamptz
  terminadaEn DateTime? @map("terminada_en") @db.Timestamptz
  facturas    Int       @default(0)
  enlazadas   Int       @default(0)
  avisos      Json      @default("[]")
  error       String?   @db.VarChar(500)

  empresa Empresa  @relation(fields: [empresaId], references: [id])
  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([empresaId, iniciadaEn(sort: Desc)], map: "ix_sincronizaciones_siigo")
  @@map("sincronizaciones_siigo")
}

/// Certificado comercial del cliente (modelo PD-GG-F-01, dinámico). Copia fija: uno por cliente y día, no se modifica ni
/// se borra (trigger), PDF en el almacenamiento y código QR. RLS: en el portal cada cliente ve solo los suyos.
model CertificadoComercial {
  id                 String   @id @default(uuid()) @db.Uuid
  empresaId          String   @map("empresa_id") @db.Uuid
  clienteId          String   @map("cliente_id") @db.Uuid
  numero             String   @db.VarChar(20) // CC-2026-0001 (fn_siguiente_consecutivo, documento CERT_COMERCIAL)
  fecha              DateTime @db.Date // día de expedición (Colombia)
  contenido          Json // lo que dice: con esto se armó el PDF
  pdfUrl             String   @map("pdf_url") // clave en el almacenamiento (Cloudflare R2 en producción)
  pdfSha256          String   @map("pdf_sha256") @db.Char(64)
  codigoVerificacion String   @unique @map("codigo_verificacion") @db.VarChar(40)
  solicitadoPorId    String?  @map("solicitado_por_id") @db.Uuid
  creadoEn           DateTime @default(now()) @map("creado_en") @db.Timestamptz

  empresa       Empresa  @relation(fields: [empresaId], references: [id])
  cliente       Cliente  @relation(fields: [clienteId], references: [id])
  solicitadoPor Usuario? @relation("CertificadoComercialSolicitante", fields: [solicitadoPorId], references: [id])

  @@unique([empresaId, numero])
  @@unique([clienteId, fecha])
  @@map("certificados_comerciales")
}

enum EstadoTrabajo {
  PENDIENTE
  EN_CURSO
  LISTO
  FALLIDO
  VENCIDO
}

model Auditoria {
  id        BigInt   @id @default(autoincrement())
  usuarioId String?  @map("usuario_id") @db.Uuid
  entidad   String   @db.VarChar(60)
  entidadId String   @map("entidad_id")
  accion    String   @db.VarChar(20)
  antes     Json?
  despues   Json?
  fecha     DateTime @default(now()) @db.Timestamptz
  ip        String?  @db.VarChar(64) // desde dónde (requisitos de producción §3)
  agente    String?  @db.VarChar(300) // navegador o app
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([entidad, entidadId])
  @@index([fecha], map: "ix_auditoria_fecha")
  @@index([usuarioId, fecha], map: "ix_auditoria_usuario")
  @@index([accion, fecha(sort: Desc)], map: "ix_auditoria_accion_fecha")
  @@map("auditoria")
}

// ---------------------------------------------------------------------
// CARGUES MASIVOS (plantillas de Excel)
// ---------------------------------------------------------------------
model CargueMasivo {
  id              String       @id @default(uuid()) @db.Uuid
  empresaId       String       @map("empresa_id") @db.Uuid
  plantilla       String       @db.VarChar(40) // clientes | sucursales | decl-residuos | decl-servicios | precios | vehiculos | usuarios | solicitudes
  clienteId       String?      @map("cliente_id") @db.Uuid // cargue de un cliente directo o gestor
  tipoCargue      TipoCargue?  @map("tipo_cargue")
  formato         String       @default("XLSX") @db.VarChar(4) // XLSX | CSV
  delimitador     String?      @db.Char(1) // CSV: , ; | o tabulador
  archivo         String       @db.VarChar(200)
  archivoHash     String?      @map("archivo_hash") @db.Char(64) // SHA-256: avisa si el mismo archivo ya se cargó
  archivoUrl      String?      @map("archivo_url") // copia del original (S3) para auditoría
  estado          EstadoCargue @default(VALIDADO)
  filasLeidas     Int          @map("filas_leidas")
  filasOk         Int          @map("filas_ok")
  filasError      Int          @map("filas_error")
  errores         Json         @default("[]") // [{fila, columna, valor, mensaje}]
  usuarioId       String       @map("usuario_id") @db.Uuid
  creadoEn        DateTime     @default(now()) @map("creado_en") @db.Timestamptz
  // Lote deshecho (solo declaraciones): sus declaraciones quedan ANULADAS; el lote no cambia más
  revertidoEn     DateTime?    @map("revertido_en") @db.Timestamptz
  revertidoPorId  String?      @map("revertido_por") @db.Uuid
  motivoReversion String?      @map("motivo_reversion") @db.VarChar(300)

  empresa       Empresa       @relation(fields: [empresaId], references: [id])
  cliente       Cliente?      @relation(fields: [clienteId], references: [id])
  revertidoPor  Usuario?      @relation("CargueRevertidoPor", fields: [revertidoPorId], references: [id], onDelete: Restrict)
  declaraciones Declaracion[] // lo que creó este lote (permite revisar o revertir el lote)

  @@index([empresaId, creadoEn])
  @@index([empresaId, archivoHash])
  @@map("cargues_masivos")
}

// ---------------------------------------------------------------------
// DECLARACIONES — RELACIONES MUCHOS A MUCHOS
// ---------------------------------------------------------------------

/// [1] Sedes generadoras de la declaración (1 declaración → N sedes).
model DeclaracionSucursal {
  declaracionId String   @map("declaracion_id") @db.Uuid
  sucursalId    String   @map("sucursal_id") @db.Uuid
  activa        Boolean  @default(true) // permite suspender una sede sin tocar las demás
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz

  declaracion Declaracion @relation(fields: [declaracionId], references: [id], onDelete: Cascade)
  sucursal    Sucursal    @relation(fields: [sucursalId], references: [id], onDelete: Cascade)

  @@id([declaracionId, sucursalId])
  @@index([sucursalId])
  @@map("declaracion_sucursales")
}

/// [5] Disposiciones / manejos de la declaración (selección múltiple).
model DeclaracionDisposicion {
  declaracionId String  @map("declaracion_id") @db.Uuid
  disposicionId String  @map("disposicion_id") @db.Uuid
  principal     Boolean @default(false) // la que va al certificado si hay varias

  declaracion Declaracion @relation(fields: [declaracionId], references: [id], onDelete: Cascade)
  disposicion Disposicion @relation(fields: [disposicionId], references: [id])

  @@id([declaracionId, disposicionId])
  @@map("declaracion_disposiciones")
}

/// [2] Riesgos CRETIB (+ radiactivo).
model DeclaracionRiesgo {
  declaracionId String @map("declaracion_id") @db.Uuid
  riesgoId      String @map("riesgo_id") @db.Uuid

  declaracion Declaracion @relation(fields: [declaracionId], references: [id], onDelete: Cascade)
  riesgo      Riesgo      @relation(fields: [riesgoId], references: [id])

  @@id([declaracionId, riesgoId])
  @@map("declaracion_riesgos")
}

/// [2] Sistemas de etiquetado (selección múltiple: ONU + SGA es lo usual).
model DeclaracionEtiquetado {
  declaracionId String @map("declaracion_id") @db.Uuid
  sistemaId     String @map("sistema_id") @db.Uuid

  declaracion Declaracion       @relation(fields: [declaracionId], references: [id], onDelete: Cascade)
  sistema     SistemaEtiquetado @relation(fields: [sistemaId], references: [id])

  @@id([declaracionId, sistemaId])
  @@map("declaracion_etiquetados")
}

/// Qué disposiciones ampara cada permiso ambiental. Base de la regla
/// «no se autoriza una declaración si ningún permiso vigente cubre su manejo».
model PermisoDisposicion {
  permisoId     String @map("permiso_id") @db.Uuid
  disposicionId String @map("disposicion_id") @db.Uuid

  permiso     PermisoAmbiental @relation(fields: [permisoId], references: [id], onDelete: Cascade)
  disposicion Disposicion      @relation(fields: [disposicionId], references: [id], onDelete: Cascade)

  @@id([permisoId, disposicionId])
  @@map("permiso_disposiciones")
}

// ---------------------------------------------------------------------
// DECLARACIONES — TABLAS PARAMÉTRICAS (por empresa)
// `codigo` es estable y es lo que se escribe en las plantillas de cargue masivo.
// No se borran: se desactivan (activo = false) para no romper declaraciones históricas.
// ---------------------------------------------------------------------

/// Categorías del declarado (agrupación comercial/reportes).
model CategoriaDeclarado {
  id          String  @id @default(uuid()) @db.Uuid
  empresaId   String  @map("empresa_id") @db.Uuid
  codigo      String  @db.VarChar(20)
  nombre      String  @db.VarChar(100)
  descripcion String?
  activo      Boolean @default(true)

  empresa       Empresa       @relation(fields: [empresaId], references: [id])
  declaraciones Declaracion[]

  @@unique([empresaId, codigo])
  @@map("categorias_declarado")
}

/// Tipo de residuo: hospitalario, industrial, especial, reciclable, RAEE, orgánico, N/A.
model TipoResiduo {
  id        String  @id @default(uuid()) @db.Uuid
  empresaId String  @map("empresa_id") @db.Uuid
  codigo    String  @db.VarChar(20)
  nombre    String  @db.VarChar(80)
  activo    Boolean @default(true)

  empresa       Empresa       @relation(fields: [empresaId], references: [id])
  declaraciones Declaracion[]

  @@unique([empresaId, codigo])
  @@map("tipos_residuo")
}

/// Unidades de negocio. `sigla` = prefijo en factura electrónica.
model UnidadNegocio {
  id          String  @id @default(uuid()) @db.Uuid
  empresaId   String  @map("empresa_id") @db.Uuid
  codigo      String  @db.VarChar(20)
  nombre      String  @db.VarChar(100)
  descripcion String?
  sigla       String? @db.VarChar(10)
  activo      Boolean @default(true)

  empresa Empresa         @relation(fields: [empresaId], references: [id])
  lineas  LineaServicio[]

  @@unique([empresaId, codigo])
  @@map("unidades_negocio")
}

/// Líneas de servicio (cada una pertenece a una unidad de negocio).
model LineaServicio {
  id              String  @id @default(uuid()) @db.Uuid
  empresaId       String  @map("empresa_id") @db.Uuid
  unidadNegocioId String  @map("unidad_negocio_id") @db.Uuid
  codigo          String  @db.VarChar(20)
  nombre          String  @db.VarChar(150)
  descripcion     String?
  activo          Boolean @default(true)

  empresa       Empresa           @relation(fields: [empresaId], references: [id])
  unidadNegocio UnidadNegocio     @relation(fields: [unidadNegocioId], references: [id])
  declaraciones Declaracion[]
  catalogo      CatalogoResiduo[]

  @@unique([empresaId, codigo])
  @@map("lineas_servicio")
}

/// Métricas de precio (kg, ton, viaje…) y de densidad (kg/m³, g/mL…).
model Metrica {
  id          String     @id @default(uuid()) @db.Uuid
  empresaId   String     @map("empresa_id") @db.Uuid
  codigo      String     @db.VarChar(20) // = abreviación: "kg", "ton", "kg/m3"
  nombre      String     @db.VarChar(60)
  abreviacion String     @db.VarChar(20)
  uso         UsoMetrica
  factorAKg   Decimal?   @map("factor_a_kg") @db.Decimal(14, 6) // ton = 1000; para informes en kg
  activo      Boolean    @default(true)

  empresa           Empresa            @relation(fields: [empresaId], references: [id])
  tarifas           Tarifa[]
  declaraciones     Declaracion[]
  manifiestoItems   ManifiestoItem[]
  conciliacionItems ConciliacionItem[]

  @@unique([empresaId, codigo])
  @@map("metricas")
}

/// Disposición / manejo. Cada una dice CÓMO queda cubierta legalmente:
///  · requierePermiso = false → actividad amparada por el objeto social (aprovechamiento).
///  · propia = true            → la hace Terra Viva: debe estar en permiso_disposiciones de un permiso vigente.
///  · proveedorId              → la hace un gestor aliado: su licencia debe estar vigente.
model Disposicion {
  id               String  @id @default(uuid()) @db.Uuid
  empresaId        String  @map("empresa_id") @db.Uuid
  codigo           String  @db.VarChar(20)
  nombre           String  @db.VarChar(150)
  descripcion      String?
  soporteLegal     String? @map("soporte_legal") // texto que sale en el certificado
  requierePermiso  Boolean @default(true) @map("requiere_permiso")
  propia           Boolean @default(true)
  admitePeligrosos Boolean @default(true) @map("admite_peligrosos") // false: tratamientos de Los Pinos (Res. 000632, art. 6)
  hidrocarburos    String  @default("ADMITE") @db.VarChar(20) // ADMITE · CON_CARACTERIZACION · NO_ADMITE
  activo           Boolean @default(true)

  empresa           Empresa                  @relation(fields: [empresaId], references: [id])
  gestores          DisposicionGestor[] // gestores aliados que la hacen (basta uno con licencia vigente)
  permisos          PermisoDisposicion[]
  declaraciones     DeclaracionDisposicion[]
  manifiestoItems   ManifiestoItem[]
  conciliacionItems ConciliacionItem[]

  @@unique([empresaId, codigo])
  @@map("disposiciones")
}

model TipoEmbalaje {
  id        String  @id @default(uuid()) @db.Uuid
  empresaId String  @map("empresa_id") @db.Uuid
  codigo    String  @db.VarChar(20)
  nombre    String  @db.VarChar(80)
  esOtro    Boolean @default(false) @map("es_otro") // exige texto en otro_tipo_embalaje
  activo    Boolean @default(true)

  empresa         Empresa          @relation(fields: [empresaId], references: [id])
  declaraciones   Declaracion[]
  manifiestoItems ManifiestoItem[]

  @@unique([empresaId, codigo])
  @@map("tipos_embalaje")
}

model MaterialEmbalaje {
  id        String  @id @default(uuid()) @db.Uuid
  empresaId String  @map("empresa_id") @db.Uuid
  codigo    String  @db.VarChar(20)
  nombre    String  @db.VarChar(80)
  esOtro    Boolean @default(false) @map("es_otro")
  activo    Boolean @default(true)

  empresa       Empresa       @relation(fields: [empresaId], references: [id])
  declaraciones Declaracion[]

  @@unique([empresaId, codigo])
  @@map("materiales_embalaje")
}

// ---------------------------------------------------------------------
// CATÁLOGOS NORMATIVOS (globales: iguales para todas las empresas)
// ---------------------------------------------------------------------

/// Corrientes Y (Anexo I) y códigos A (Anexo II) — Decreto 1076 de 2015, Título 6.
model CodigoClasificacion {
  id          String                  @id @default(uuid()) @db.Uuid
  tipo        TipoCodigoClasificacion
  codigo      String                  @unique @db.VarChar(10) // "Y8", "A3020"; subcorriente IDEAM: "Y9.1"
  descripcion String
  activo      Boolean                 @default(true)
  padreId     String?                 @map("padre_id") @db.Uuid // subcorriente → su corriente (un nivel)

  padre          CodigoClasificacion?  @relation("Subcorrientes", fields: [padreId], references: [id])
  subcorrientes  CodigoClasificacion[] @relation("Subcorrientes")
  declaracionesA Declaracion[]         @relation("CodigoA")
  declaracionesY Declaracion[]         @relation("CodigoY")

  @@index([tipo])
  @@index([padreId], map: "ix_codigo_padre")
  @@map("codigos_clasificacion")
}

/// Riesgos: C, R, E, T, I, B (CRETIB) y RAD (radiactivo).
model Riesgo {
  id          String  @id @default(uuid()) @db.Uuid
  codigo      String  @unique @db.VarChar(10)
  nombre      String  @db.VarChar(60)
  descripcion String?

  declaraciones DeclaracionRiesgo[]

  @@map("riesgos")
}

/// ONU (NTC 1692 / Libro Naranja), NFPA 704, SGA, HMIS.
model SistemaEtiquetado {
  id     String @id @default(uuid()) @db.Uuid
  codigo String @unique @db.VarChar(10)
  nombre String @db.VarChar(80)

  declaraciones DeclaracionEtiquetado[]

  @@map("sistemas_etiquetado")
}

/// Municipios DIVIPOLA (DANE). Reemplaza las listas de «ciudades» con IDs propios.
model Municipio {
  codigoDane   String @id @map("codigo_dane") @db.Char(5)
  nombre       String @db.VarChar(80)
  departamento String @db.VarChar(60)

  sucursales Sucursal[]

  @@map("municipios")
}

/// Párrafos de respaldo legal del certificado. Cada código tiene versiones (una activa); el certificado guarda la que usó.
/// Un párrafo solo sale si el certificado tiene residuos con alguna de sus disposiciones (vacío = siempre).
model TextoLegal {
  id             String   @id @default(uuid()) @db.Uuid
  empresaId      String   @map("empresa_id") @db.Uuid
  codigo         String   @db.VarChar(30)
  version        Int
  titulo         String   @db.VarChar(150)
  texto          String
  disposiciones  String[] @db.VarChar(20)
  orden          Int      @default(0) @db.SmallInt
  vigenteDesde   DateTime @default(dbgenerated("CURRENT_DATE")) @map("vigente_desde") @db.Date
  activo         Boolean  @default(true)
  revisado       Boolean  @default(false) // texto inicial pendiente de revisión jurídica
  soloPeligrosos Boolean  @default(false) @map("solo_peligrosos") // sale solo si el certificado tiene residuos peligrosos
  creadoPorId    String?  @map("creado_por") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  creadoPor Usuario? @relation("TextoLegalCreadoPor", fields: [creadoPorId], references: [id])

  @@unique([empresaId, codigo, version])
  @@map("textos_legales")
}

/// Gestores aliados de cada disposición (una disposición puede tener varios: celda de seguridad → Veolia SI y CGS).
model DisposicionGestor {
  disposicionId String @map("disposicion_id") @db.Uuid
  proveedorId   String @map("proveedor_id") @db.Uuid

  disposicion Disposicion @relation(fields: [disposicionId], references: [id], onDelete: Cascade)
  proveedor   Proveedor   @relation(fields: [proveedorId], references: [id], onDelete: Cascade)

  @@id([disposicionId, proveedorId])
  @@index([proveedorId], map: "ix_disposicion_gestor_proveedor")
  @@map("disposicion_gestores")
}
